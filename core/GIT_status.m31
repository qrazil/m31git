// Working-tree status: what changed, compared two ways at once -- the
// working tree against the index (what `git add` would pick up) and the
// index against HEAD's tree (what a commit right now would record).
//
// This is git's own two-stage model, not a simplification of it: a file can
// be modified on disk and unstaged, modified on disk and staged with THAT
// version, or both at once with two different sets of bytes. Answering
// either question needs a full recursive tree read (for HEAD) or a full
// index read; answering both needs one pass over the working tree that is
// compared against each.
//
// API
// ---
//   GIT_status.status(gitdir, worktree)  -> Result<Status, Error>
//
// `Status` is four lists -- `staged`, `unstaged`, `untracked`, `unmerged` -- and is
// deliberately not shaped like any particular command's output: nothing here
// prints a `git status --short` line, or groups by directory, or colours
// anything. That is a future caller's job, and there is no such caller yet
// (`docs/design.md`'s "dependency chain" section). This hands back
// structure and nothing else.
//
// --- unmerged paths ----------------------------------------------------------
//
// A path that has index entries at stage 1, 2 or 3 (base, ours, theirs: a
// merge that stopped on it) is neither staged nor unstaged: it is its own
// category, `Status.unmerged`, and appears in no other list -- not as
// untracked either, and not as "deleted" when HEAD has it. `Unmerged.kind` is
// the pair of letters `git status --porcelain` prints (`Conflict.code()`),
// worked out from which of the three stages exist, as git does:
//
//     stages 1 2 3   UU  both modified      stages 2 3   AA  both added
//     stages 1 2     UD  deleted by them    stages 1 3   DU  deleted by us
//     stage  2       AU  added by us        stage  3     UA  added by them
//     stage  1       DD  both deleted
//
// Anything that decides whether a path is safe to overwrite (checkout, a
// reset) has to count `unmerged` as modified: nothing in `staged`/`unstaged`
// says so.
//
// --- the mtime/size shortcut is not optional ---------------------------------
//
// For each index entry this compares `fs.stat`'s size and mtime against what
// was recorded when the file was staged, and only opens and re-hashes the
// file when one of them disagrees. This is git's own `ce_match_stat`
// optimisation and not a simplification made for this program: a real
// repository is re-hashed on every `status` otherwise, which is the
// difference between a command that costs milliseconds and one that costs
// as long as reading the whole tree, every time it runs.
//
// --- what this cannot do, and why -------------------------------------------
//
// **Symlinks are compared by target.** git's blob for a symlink holds its
// target text, which `fs.readlink` (m31 v0.4.5) returns; a link in the index
// and in the working tree is `Modified` when the two differ, and a link where
// a file was (or the reverse) is a type change, which `GIT_gitstatus`
// reports.
//
// **Submodules (gitlink entries, mode 0o160000) are ignored** in the
// unstaged comparison for the same shape of reason -- there is no submodule
// support anywhere in this program, so a gitlink entry is left out of the
// working-tree comparison rather than compared against whatever directory
// happens to occupy its path.
//
// **A path that is not valid UTF-8** -- in the index or in HEAD's tree --
// is left out of both comparisons. `GIT_object.m31`'s own module header notes
// that a tree's names are octets and need not be UTF-8; this module's
// internal comparisons are keyed by `str` (a `Map`'s key, and `bytes` cannot
// be one, reference §3.9), and `fs.walk` itself cannot enumerate such a name
// from the working tree side regardless -- so a non-UTF-8 path is already a
// path this program's `fs` layer cannot fully see, and this does not pretend
// otherwise. Every path this program itself ever writes is UTF-8, so this
// only bites a working tree built by something else.
//
// **`.gitignore` filtering is `GIT_ignore.m31`'s job, not this module's.**
// A candidate path that is on disk and not in the index used to be reported
// untracked unconditionally; now `GIT_ignore.Ignore.is_ignored` is asked
// about each one first, and an ignored path is left out, matching what
// `git status`'s own untracked-file scan does. The pattern matching, the
// nested-`.gitignore` precedence and the negated-pattern-inside-an-excluded-
// directory exception all live in `GIT_ignore.m31`'s own module header --
// this module only calls it.

import io;
import fs;
import text;
import core.GIT_object;
import core.GIT_pack;
import core.GIT_refs;
import core.GIT_index;
import core.GIT_ignore;
import core.GIT_icase;
import core.GIT_config;

/// Why a status could not be produced. Payload-free variants wrap the
/// underlying error (docs/errors-decision.md §4): the path or the object
/// name is context the caller already has.
pub enum Error {
    /// A working-tree read or listing failed outright (a permissions error,
    /// typically -- `NotFound` is not this, since a missing file mid-walk is
    /// itself a "deleted" answer, not a failure to answer).
    Io;
    Index(GIT_index.Error);
    Object(GIT_object.Error);
    Refs(GIT_refs.Error);
    Gitignore(GIT_ignore.Error);
    /// HEAD resolves to something that is not a commit -- a corrupt or a
    /// very strange repository, not one this can report on.
    HeadNotCommit;
}

pub str Error.to_str() {
    match (this) {
        case Io: {
            return "the working tree could not be read";
        }
        case Index(GIT_index.Error error): {
            return "index: " + error.to_str();
        }
        case Object(GIT_object.Error error): {
            return "object: " + error.to_str();
        }
        case Refs(GIT_refs.Error error): {
            return "refs: " + error.to_str();
        }
        case Gitignore(GIT_ignore.Error error): {
            return "gitignore: " + error.to_str();
        }
        case HeadNotCommit: {
            return "HEAD does not resolve to a commit";
        }
    }
}

/// The three things a change to a tracked path can be. There is no `Renamed`:
/// git itself does not record one, only detects it after the fact by
/// comparing an `Added` against a `Deleted`, which is a future caller's job
/// and not this module's.
pub enum Change {
    Added;
    Modified;
    Deleted;
}

/// One path and what changed about it, in one of the two comparisons
/// `Status` holds separately.
pub type Delta {
    pub bytes path;
    pub Change kind;
}

/// What is wrong with an unmerged path, named for who did what -- "us" is
/// the side being merged into (stage 2), "them" the side merged in (stage 3).
pub enum Conflict {
    /// Stages 1, 2 and 3: changed on both sides (`UU`).
    BothModified;
    /// Stages 2 and 3, no base: added on both sides (`AA`).
    BothAdded;
    /// Stage 1 alone: removed on both sides (`DD`).
    BothDeleted;
    /// Stage 2 alone: added by us (`AU`).
    AddedByUs;
    /// Stage 3 alone: added by them (`UA`).
    AddedByThem;
    /// Stages 1 and 3: deleted by us, changed by them (`DU`).
    DeletedByUs;
    /// Stages 1 and 2: changed by us, deleted by them (`UD`).
    DeletedByThem;
}

/// The two letters `git status --porcelain` prints for this conflict.
pub str Conflict.code() {
    match (this) {
        case BothModified: {
            return "UU";
        }
        case BothAdded: {
            return "AA";
        }
        case BothDeleted: {
            return "DD";
        }
        case AddedByUs: {
            return "AU";
        }
        case AddedByThem: {
            return "UA";
        }
        case DeletedByUs: {
            return "DU";
        }
        case DeletedByThem: {
            return "UD";
        }
    }
}

/// One path the index holds in conflict. The `*_id` of a side that does not
/// exist is `""` and its mode 0.
pub type Unmerged {
    pub bytes path;
    pub Conflict kind;
    pub str base_id;
    pub str ours_id;
    pub str theirs_id;
    pub int base_mode;
    pub int ours_mode;
    pub int theirs_mode;
}

/// A full status: the index against HEAD's tree, the working tree against
/// the index, and what is on disk but in neither.
pub type Status {
    /// Index vs HEAD -- what a commit right now would record.
    pub List<Delta> staged;
    /// Working tree vs index -- what `git add` would pick up.
    pub List<Delta> unstaged;
    /// In the working tree, not in the index.
    pub List<bytes> untracked;
    /// Index entries at stages 1/2/3, one per path, in path order. See the
    /// module header; these paths are in none of the other lists.
    pub List<Unmerged> unmerged = [];
}

/// The status of the repository at `gitdir` whose working tree is at
/// `worktree`.
pub Result<Status, Error> status(str gitdir, str worktree) {
    return status_with(gitdir, worktree, GIT_icase.enabled(GIT_config.effective(gitdir)));
}

/// `status`, with `core.ignorecase` given (a `-c core.ignorecase=...` on the
/// command line is not in the files `status` reads it from): a work-tree path
/// that folds to an index path is that path, not an untracked file.
pub Result<Status, Error> status_with(str gitdir, str worktree, bool is_icase) {
    Map<str, str> none = {};
    return status_core(gitdir, worktree, is_icase, false, none);
}

/// `status_with` for a caller that has already read HEAD's tree (`head`: every
/// blob path and its id, as `walk_tree` makes it): the tree is not read again.
pub Result<Status, Error> status_given(str gitdir, str worktree, bool is_icase, Map<str, str> head) {
    return status_core(gitdir, worktree, is_icase, true, head);
}

Result<Status, Error> status_core(str gitdir, str worktree, bool is_icase, bool has_head, Map<str, str> given_head) {
    bool is_pre = GIT_icase.precompose(GIT_config.effective(gitdir));
    Map<str, GIT_index.Entry> staged_entries = {};
    List<Unmerged> unmerged = [];
    List<str> conflict_order = [];
    Map<str, Unmerged> conflicts = {};
    match (GIT_index.read(gitdir)) {
        case Ok(GIT_index.Index index): {
            for (GIT_index.Entry entry in index.entries) {
                match (entry.path.utf8()) {
                    case Some(str path): {
                        if (entry.stage == 0) {
                            staged_entries.set(path, entry);
                        } else {
                            note_conflict(conflict_order, conflicts, path, entry);
                        }
                    }
                    case None: {
                    }
                }
            }
        }
        case Err(GIT_index.Error error): {
            match (error) {
                case NotFound: {
                }
                case Io: {
                    return Result<Status, Error>.Err(Error.Index(error));
                }
                case BadSignature: {
                    return Result<Status, Error>.Err(Error.Index(error));
                }
                case BadVersion: {
                    return Result<Status, Error>.Err(Error.Index(error));
                }
                case Truncated: {
                    return Result<Status, Error>.Err(Error.Index(error));
                }
                case BadExtension: {
                    return Result<Status, Error>.Err(Error.Index(error));
                }
                case Checksum: {
                    return Result<Status, Error>.Err(Error.Index(error));
                }
                case RequiredExtension: {
                    return Result<Status, Error>.Err(Error.Index(error));
                }
                case Locked: {
                    return Result<Status, Error>.Err(Error.Index(error));
                }
                case Changed: {
                    return Result<Status, Error>.Err(Error.Index(error));
                }
            }
        }
    }
    Map<str, str> head = given_head;
    if (!has_head) {
        match (head_tree(gitdir)) {
            case Ok(Option<str> link_target): {
                match (link_target) {
                    case Some(str tree): {
                        walk_tree(GIT_pack.cache(gitdir), gitdir, tree, "", head)?;
                    }
                    case None: {
                    }
                }
            }
            case Err(Error error): {
                return Result<Status, Error>.Err(error);
            }
        }
    }
    List<WFile> worktree_files = list_worktree(worktree, is_pre)?;
    if (is_icase) {
        // git decides that a tracked file is there by `lstat` of the index
        // spelling, not by what readdir lists: on a volume that folds case
        // the old spelling of a renamed file still answers
        Map<str, bool> listed = {};
        for (WFile file in worktree_files) {
            listed.set(file.path, true);
        }
        for (str path in staged_entries.keys()) {
            if (listed.contains(path)) {
                continue;
            }
            str named = fs.join(worktree, path);
            if (fs.is_link(named)) {
                worktree_files.push(WFile(path, true));
            } else if (fs.is_file(named)) {
                worktree_files.push(WFile(path, false));
            }
        }
    }
    Map<str, bool> wt_link = {};
    for (WFile file in worktree_files) {
        wt_link.set(file.path, file.is_link);
    }
    List<Delta> staged = [];
    for (str path in staged_entries.keys()) {
        str iid = get_entry(staged_entries, path).id;
        match (head.get(path)) {
            case Some(str hid): {
                if (hid != iid) {
                    staged.push(Delta(path.to_bytes(), Change.Modified));
                }
            }
            case None: {
                staged.push(Delta(path.to_bytes(), Change.Added));
            }
        }
    }
    for (str path in head.keys()) {
        if (!staged_entries.contains(path) && !conflicts.contains(path)) {
            staged.push(Delta(path.to_bytes(), Change.Deleted));
        }
    }
    List<Delta> unstaged = [];
    for (str path in staged_entries.keys()) {
        GIT_index.Entry entry = get_entry(staged_entries, path);
        if (entry.is_gitlink()) {
            continue;
        }
        bool is_present = wt_link.contains(path);
        if (!is_present) {
            unstaged.push(Delta(path.to_bytes(), Change.Deleted));
            continue;
        }
        str full = fs.join(worktree, path);
        if (wt_link.get(path).or(false)) {
            // a link against a link: the blob is the target text. A link
            // where the index has a file is a type change, which
            // `GIT_gitstatus.mode_pass` reports.
            if (entry.is_link()) {
                match (fs.readlink(full)) {
                    case Ok(str target): {
                        if (GIT_object.blob_id_like(entry.id, target.to_bytes()) != entry.id) {
                            unstaged.push(Delta(path.to_bytes(), Change.Modified));
                        }
                    }
                    case Err(_): {
                    }
                }
            }
            continue;
        }
        if (entry.is_link()) {
            // a file where the index has a link: a type change
            continue;
        }
        match (fs.stat(full)) {
            case Ok(fs.Stat stat): {
                int mtime = entry.mtime_s * 1_000_000_000 + entry.mtime_ns;
                if (stat.size == entry.size && stat.mtime_ns == mtime) {
                    continue;
                }
                match (io.read_bytes(full)) {
                    case Ok(bytes content): {
                        if (GIT_object.blob_id_like(entry.id, content) != entry.id) {
                            unstaged.push(Delta(path.to_bytes(), Change.Modified));
                        }
                    }
                    case Err(_): {
                        unstaged.push(Delta(path.to_bytes(), Change.Modified));
                    }
                }
            }
            case Err(_): {
                unstaged.push(Delta(path.to_bytes(), Change.Deleted));
            }
        }
    }
    GIT_ignore.Ignore ignore = load_ignore_among(gitdir, worktree, is_icase, is_pre, worktree_files)?;
    List<bytes> untracked = [];
    GIT_icase.Names folded = GIT_icase.Names();
    if (is_icase) {
        for (str path in staged_entries.keys()) {
            folded.add(path);
        }
        for (str path in conflicts.keys()) {
            folded.add(path);
        }
    }
    for (WFile file in worktree_files) {
        if (is_icase && folded.has_file(file.path)) {
            continue;
        }
        if (!staged_entries.contains(file.path) && !conflicts.contains(file.path) && !ignore.is_ignored(file.path)) {
            untracked.push(file.path.to_bytes());
        }
    }
    for (str path in conflict_order) {
        match (conflicts.get(path)) {
            case Some(Unmerged each): {
                unmerged.push(Unmerged(each.path, conflict_kind(each), each.base_id, each.ours_id, each.theirs_id, each.base_mode, each.ours_mode, each.theirs_mode));
            }
            case None: {
            }
        }
    }
    Status result = Status(staged, unstaged, untracked);
    result.unmerged = unmerged;
    return Result<Status, Error>.Ok(result);
}

// Fold one stage-1/2/3 entry into its path's `Unmerged` (made on first sight;
// `order` remembers first sight, and the index is in path order).
void note_conflict(List<str> order, Map<str, Unmerged> by_path, str path, GIT_index.Entry entry) {
    Unmerged slot = Unmerged(path.to_bytes(), Conflict.BothModified, "", "", "", 0, 0, 0);
    match (by_path.get(path)) {
        case Some(Unmerged known): {
            slot = known;
        }
        case None: {
            order.push(path);
        }
    }
    if (entry.stage == 1) {
        slot = Unmerged(slot.path, slot.kind, entry.id, slot.ours_id, slot.theirs_id, entry.mode, slot.ours_mode, slot.theirs_mode);
    } else if (entry.stage == 2) {
        slot = Unmerged(slot.path, slot.kind, slot.base_id, entry.id, slot.theirs_id, slot.base_mode, entry.mode, slot.theirs_mode);
    } else {
        slot = Unmerged(slot.path, slot.kind, slot.base_id, slot.ours_id, entry.id, slot.base_mode, slot.ours_mode, entry.mode);
    }
    by_path.set(path, slot);
}

// Which of the seven conflicts the present stages make (module header).
Conflict conflict_kind(Unmerged each) {
    bool has_base = each.base_id != "";
    bool has_ours = each.ours_id != "";
    bool has_theirs = each.theirs_id != "";
    if (has_ours && has_theirs) {
        if (has_base) {
            return Conflict.BothModified;
        }
        return Conflict.BothAdded;
    }
    if (has_ours) {
        if (has_base) {
            return Conflict.DeletedByThem;
        }
        return Conflict.AddedByUs;
    }
    if (has_theirs) {
        if (has_base) {
            return Conflict.DeletedByUs;
        }
        return Conflict.AddedByThem;
    }
    return Conflict.BothDeleted;
}

GIT_index.Entry get_entry(Map<str, GIT_index.Entry> staged_entries, str path) {
    match (staged_entries.get(path)) {
        case Some(GIT_index.Entry entry): {
            return entry;
        }
        case None: {
            trap("status: an index entry looked up by its own key was not found");
        }
    }
}

// HEAD's tree, or `None` for an unborn branch (a fresh `git init`, nothing
// committed yet) -- not an error, since "nothing is committed" is a perfectly
// good status to report on.
Result<Option<str>, Error> head_tree(str gitdir) {
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Unborn(str name): {
                    return Result<Option<str>, Error>.Ok(Option<str>.None);
                }
                case Born(str name, str id): {
                    str tree = commit_tree(gitdir, id)?;
                    return Result<Option<str>, Error>.Ok(Option<str>.Some(tree));
                }
                case Detached(str id): {
                    str tree = commit_tree(gitdir, id)?;
                    return Result<Option<str>, Error>.Ok(Option<str>.Some(tree));
                }
            }
        }
        case Err(GIT_refs.Error error): {
            return Result<Option<str>, Error>.Err(Error.Refs(error));
        }
    }
}

// `GIT_ignore.load`'s own error, wrapped at this module's own Error type --
// the same shape `commit_tree` below uses for `GIT_object.Error` -- so `status`
// can propagate it with a plain `?` (§6.3: `?`'s error type must match the
// enclosing function's exactly, with no conversion).
Result<GIT_ignore.Ignore, Error> load_ignore(str gitdir, str worktree, bool is_icase, bool is_precomposed) {
    match (GIT_ignore.load_with(gitdir, worktree, is_icase, is_precomposed)) {
        case Ok(GIT_ignore.Ignore ignore): {
            return Result<GIT_ignore.Ignore, Error>.Ok(ignore);
        }
        case Err(GIT_ignore.Error error): {
            return Result<GIT_ignore.Ignore, Error>.Err(Error.Gitignore(error));
        }
    }
}

// `load_ignore` for a caller that has just listed the work tree: the
// `.gitignore` files are picked out of that listing instead of walking the
// tree a second time. The spellings that listing may not hold as the disk has
// them (case-folding volumes, precomposed names) keep the walk.
Result<GIT_ignore.Ignore, Error> load_ignore_among(str gitdir, str worktree, bool is_icase, bool is_precomposed, List<WFile> listed) {
    if (is_icase || is_precomposed) {
        return load_ignore(gitdir, worktree, is_icase, is_precomposed);
    }
    List<str> relatives = [];
    for (WFile each in listed) {
        if (each.path == ".gitignore" || each.path.ends_with("/.gitignore")) {
            relatives.push(each.path);
        }
    }
    match (GIT_ignore.load_known(gitdir, worktree, is_icase, is_precomposed, relatives)) {
        case Ok(GIT_ignore.Ignore ignore): {
            return Result<GIT_ignore.Ignore, Error>.Ok(ignore);
        }
        case Err(GIT_ignore.Error error): {
            return Result<GIT_ignore.Ignore, Error>.Err(Error.Gitignore(error));
        }
    }
}

Result<str, Error> commit_tree(str gitdir, str id) {
    match (GIT_object.read(gitdir, id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Commit(GIT_object.Commit commit): {
                    return Result<str, Error>.Ok(commit.tree);
                }
                case Blob: {
                    return Result<str, Error>.Err(Error.HeadNotCommit);
                }
                case Tree: {
                    return Result<str, Error>.Err(Error.HeadNotCommit);
                }
                case Tag: {
                    return Result<str, Error>.Err(Error.HeadNotCommit);
                }
            }
        }
        case Err(GIT_object.Error error): {
            return Result<str, Error>.Err(Error.Object(error));
        }
    }
}

// Every blob HEAD's tree reaches, recursively, keyed by its full path from
// the repository root. A name that is not UTF-8 is left out (module header).
Result<bool, Error> walk_tree(GIT_pack.Cache packs, str gitdir, str id, str prefix, Map<str, str> out) {
    match (GIT_object.read_with(packs, gitdir, id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Tree(List<GIT_object.Entry> entries): {
                    for (GIT_object.Entry entry in entries) {
                        match (entry.name.utf8()) {
                            case Some(str name): {
                                str full = name;
                                if (prefix != "") {
                                    full = prefix + "/" + name;
                                }
                                if (entry.is_tree()) {
                                    walk_tree(packs, gitdir, entry.id, full, out)?;
                                } else {
                                    out.set(full, entry.id);
                                }
                            }
                            case None: {
                            }
                        }
                    }
                    return Result<bool, Error>.Ok(true);
                }
                case Blob: {
                    return Result<bool, Error>.Err(Error.HeadNotCommit);
                }
                case Commit: {
                    return Result<bool, Error>.Err(Error.HeadNotCommit);
                }
                case Tag: {
                    return Result<bool, Error>.Err(Error.HeadNotCommit);
                }
            }
        }
        case Err(GIT_object.Error error): {
            return Result<bool, Error>.Err(Error.Object(error));
        }
    }
}

// One file (or symlink) under the working tree, repository-relative.
type WFile {
    str path;
    bool is_link;
}

// Every regular file and symlink under `worktree`, `.git` excluded, as paths
// relative to it. A directory contributes nothing itself -- only what is
// inside it, which `fs.walk` already visits.
Result<List<WFile>, Error> list_worktree(str worktree, bool is_precomposed) {
    List<WFile> out = [];
    match (walk_files(fs.join(worktree, ""), worktree, is_precomposed, out)) {
        case Ok: {
        }
        case Err(_): {
            return Result<List<WFile>, Error>.Err(Error.Io);
        }
    }
    return Result<List<WFile>, Error>.Ok(out);
}

// `fs.walk`'s order (a directory's names sorted, each directory's contents
// right after it) with what `list_worktree` wants made on the way: two
// system calls for an entry (is it a link; if not, what is it) where `walk`
// followed by three questions asked again took four, and `.git` is not
// entered at all -- `fs.walk` listed every object file in it just to have
// them dropped.
Result<bool, io.Error> walk_files(str base, str directory, bool is_precomposed, List<WFile> out) {
    for (str name in fs.listdir(directory)?) {
        str path = fs.join(directory, name);
        str relative_path = text.strip_prefix(path, base);
        if (relative_path == ".git") {
            continue;
        }
        if (fs.is_link(path)) {
            out.push(WFile(GIT_icase.nfc_if(is_precomposed, relative_path), true));
            continue;
        }
        match (fs.stat(path)) {
            case Ok(fs.Stat found): {
                if (found.is_directory()) {
                    walk_files(base, path, is_precomposed, out)?;
                } else if (found.is_file()) {
                    // `core.precomposeunicode`: the name as git's readdir hands it over
                    out.push(WFile(GIT_icase.nfc_if(is_precomposed, relative_path), false));
                }
            }
            case Err(io.Error failure): {
                return Result<bool, io.Error>.Err(failure);
            }
        }
    }
    return Result<bool, io.Error>.Ok(true);
}
