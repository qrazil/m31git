// The command-line surface of `1git`, as data: every command, its options and
// operands, and how each one is spelled in git's own grammar. One table feeds
// three consumers, so they cannot drift apart:
//
//   * the parser declarations (`GIT_cli.build`): `--help`, usage errors,
//     completions;
//   * the translation to git's argv, which the command functions still take
//     (`GIT_cli.to_git`);
//   * the transition shim and `-migrate`, which rewrite git's argv into ours
//     (`GIT_cli.from_git`).
//
// One line per option or operand: the kind, the name, any number of
// `key=value` attributes, and the help text last, all separated by `|`.
//
//   kind   flag     a switch
//          value    one str
//          choice   one str out of `c=`
//          int      one whole number
//          values   a greedy list
//          pos      a required operand      opt   an optional one (`d=`)
//          tail     zero or more operands
//   s=     the one-letter short (`--n`)
//   p=     the placeholder in the help (a choice shows its keys)
//   d=     the default, as it would be typed, shown by the help
//   e=     what is handed to git's grammar: tokens separated by a space, `{}`
//          stands for the value (`--max-count={}`, `-m {}`). A `values` option
//          with a `{}` applies it to every element, without one it emits the
//          tokens once and then the elements. `@path` collects the elements
//          after git's `--`; other `@name`s are handled by name in GIT_cli.
//   a=     spellings git has for the same thing, read only when git's argv is
//          rewritten: templates separated by `,` (`-n {},-n{},-{}`)
//   c=     `a,b,c`, or `a=tok,b=tok`: the token each choice is emitted as (a
//          key listed twice: the first is emitted, the others only recognised)
//
// docs/CLI.md is the prose; this is what it is checked against.

/// One option or operand.
pub type Spec {
    pub str kind;
    pub str name;
    pub str short = "";
    pub str emit = "";
    pub str alias = "";
    pub str choices = "";
    pub str default = "";
    pub str placeholder = "";
    pub str help = "";
}

/// One command: `word` is what follows the dash, `git` the command function
/// it runs, `sub` the word after `git` that picks a subcommand ("" for none).
pub type Cmd {
    pub str word;
    pub str short;
    pub str git;
    pub str sub;
    pub str summary;
    pub List<Spec> specs;
}

/// A table line, as a Spec.
pub Spec parse_line(str line) {
    List<str> parts = line.split("|");
    Spec spec = Spec(parts[0], parts[1]);
    for (int index in 2 .. parts.size() - 1) {
        str part = parts[index];
        int at = part.index_of("=").or(0);
        str key = part.substr(0, at);
        str value = part.substr(at + 1, part.size());
        if (key == "s") {
            spec.short = value;
        } else if (key == "e") {
            spec.emit = value;
        } else if (key == "a") {
            spec.alias = value;
        } else if (key == "c") {
            spec.choices = value;
        } else if (key == "d") {
            spec.default = value;
        } else if (key == "p") {
            spec.placeholder = value;
        } else {
            trap("clitable: unknown attribute '" + key + "' in: " + line);
        }
    }
    spec.help = parts[parts.size() - 1];
    return spec;
}

/// The keys a `c=` list offers, in order, each once.
pub List<str> choice_keys(str choices) {
    List<str> keys = [];
    for (str entry in choices.split(",")) {
        str key = entry;
        match (entry.index_of("=")) {
            case Some(int at): {
                key = entry.substr(0, at);
            }
            case None: {
            }
        }
        if (!keys.contains(key)) {
            keys.push(key);
        }
    }
    return keys;
}

/// `target` with every element of `more` added: lists have no `extend`.
pub void append(List<str> target, List<str> more) {
    for (str item in more) {
        target.push(item);
    }
}

List<Spec> specs_of(List<str> lines) {
    List<Spec> out = [];
    for (str line in lines) {
        out.push(parse_line(line));
    }
    return out;
}

Cmd make(str word, str short, str git, str sub, str summary, List<str> lines) {
    return Cmd(word, short, git, sub, summary, specs_of(lines));
}

// What `log`, `show` and `diff` share: how the changes themselves are printed.
List<str> diff_lines() {
    return ["flag|patch|s=p|e=-p|a=--patch,-u|show the patch", "flag|stat|e=--stat|show a diffstat", "flag|numstat|e=--numstat|added and removed lines per file, for programs", "flag|shortstat|e=--shortstat|only the totals line of the diffstat", "flag|name-only|e=--name-only|show the names of the changed files", "flag|name-status|e=--name-status|show the names, each with a letter for what happened", "flag|raw|e=--raw|show git's raw diff format", "flag|summary|e=--summary|show created, deleted and renamed files and mode changes", "int|context|s=c|p=N|e=-U{}|a=--unified={},-U {}|lines of context around each change", "flag|ignore-all-space|s=w|e=-w|a=--ignore-all-space|ignore whitespace when comparing lines", "flag|ignore-space-change|s=b|e=-b|a=--ignore-space-change|ignore changes in the amount of whitespace", "choice|renames|c=on=--renames,off=--no-renames,on=-M,on=--find-renames|detect renamed files (default: diff.renames)", "int|rename-threshold|p=PERCENT|e=-M{}%|a=-M{},--find-renames={}|how similar two files must be to be a rename", "flag|swap|e=-R|swap the two sides", "choice|merge-diff|c=separate=-m,combined=-c,dense=--cc,first-parent=--dd,off=--no-diff-merges|how a merge commit shows its changes", "value|diff-filter|p=KINDS|e=--diff-filter={}|keep only these kinds: A C D M R T U (lower case leaves them out)", "choice|word-diff|c=plain=--word-diff=plain,color=--word-diff=color,porcelain=--word-diff=porcelain,none=--word-diff=none,plain=--word-diff,color=--color-words|compare by words", "flag|text|s=a|e=-a|a=--text|treat every file as text", "flag|full-index|e=--full-index|print full object names in the index lines", "flag|nul|s=z|e=-z|end each name with a NUL instead of a newline", "flag|side-by-side|s=y|e=-y|a=--side-by-side|lay the patch out as two columns, old and new", "int|width|p=COLUMNS|e=--width={}|columns for --side-by-side (default: the terminal)", "choice|color|c=always=--color=always,never=--color=never,auto=--color=auto,always=--color,never=--no-color|when to use colour (default: auto)"];
}

/// All of 1git's commands, in the order `--help` lists them: look, change,
/// history, talk to a forge, then the plumbing.
pub List<Cmd> table() {
    List<Cmd> cmds = [];
    // --- look ----------------------------------------------------------------
    cmds.push(make("status", "s", "status", "", "show what changed in the work tree and the index", ["tail|paths|p=PATH|only report these paths", "choice|format|s=f|c=long=--long,short=--short,porcelain=--porcelain,porcelain2=--porcelain=v2,short=-s,porcelain=--porcelain=v1,porcelain=--porcelain=1,porcelain2=--porcelain=2|d=long|the layout: long, short, or a stable one for programs", "flag|branch|s=b|e=--branch|a=-b|show the branch in the short layout", "flag|nul|s=z|e=-z|a=--null|end each entry with a NUL (with the porcelain layouts)", "choice|untracked|s=u|c=all=-uall,normal=-unormal,no=-uno,all=--untracked-files=all,normal=--untracked-files=normal,no=--untracked-files=no,all=--untracked-files,all=-u|how untracked files are shown (default: normal, or status.showUntrackedFiles)", "choice|ignored|c=traditional=--ignored,matching=--ignored=matching,traditional=--ignored=traditional,no=--ignored=no|also show ignored files", "choice|renames|c=on=--renames,off=--no-renames,on=-M|detect renamed files (default: status.renames)", "flag|stash|e=--show-stash|show how many stashes there are"]));
    List<str> log_lines = ["tail|revisions|p=REV|where to start: branches, tags, commits, ranges (a..b), ^excluded", "int|max|s=n|p=N|e=--max-count={}|a=-n {},-n{},--max-count {},-{}|stop after this many commits", "int|skip|p=N|e=--skip={}|skip this many commits first", "flag|oneline|e=--oneline|one line per commit", "flag|graph|e=--graph|draw the history as a graph", "flag|all|e=--all|start from every ref", "flag|first-parent|e=--first-parent|follow only the first parent of merges", "choice|merges|c=only=--merges,exclude=--no-merges|show only merge commits, or leave them out", "flag|reverse|e=--reverse|oldest first", "choice|order|c=topo=--topo-order,date=--date-order,author-date=--author-date-order|never show a commit before its children (default: commit date)", "flag|follow|e=--follow|follow a single file across renames", "flag|only-given|e=--no-walk|show just the named commits, not their ancestors", "value|author|p=PATTERN|e=--author={}|commits whose author matches", "value|committer|p=PATTERN|e=--committer={}|commits whose committer matches", "value|since|p=DATE|e=--since={}|a=--since {},--after={},--after {}|commits newer than this date", "value|until|p=DATE|e=--until={}|a=--until {},--before={},--before {}|commits older than this date", "value|touches|p=TEXT|e=-S{}|a=-S {}|commits that add or remove this text", "flag|ignore-case|s=i|e=-i|a=--regexp-ignore-case|match --author, --committer and --grep without regard to case", "choice|match|c=extended=-E,fixed=-F,basic=--basic-regexp,extended=--extended-regexp,fixed=--fixed-strings|how patterns are read (default: basic)", "flag|invert-grep|e=--invert-grep|commits whose message does not match --grep", "flag|all-match|e=--all-match|commits matching every --grep, not just one", "value|format|p=STYLE|e=--format={}|a=--pretty={},--format {},--pretty {}|oneline, short, medium, full, fuller, raw, or a format such as '%h %s'", "choice|decorate|c=short=--decorate=short,full=--decorate=full,off=--decorate=no,short=--decorate,off=--no-decorate|show the refs that point at a commit", "value|date|p=STYLE|e=--date={}|how dates are shown: iso, short, relative, raw, unix, rfc, format:...", "int|abbrev|p=N|e=--abbrev={}|digits of an abbreviated commit name"];
    append(log_lines, diff_lines());
    log_lines.push("flag|header-only|s=s|e=-s|a=--no-patch|leave out the changes");
    log_lines.push("values|grep|p=PATTERN|e=--grep={}|commits whose message matches any of these (put it after the revisions)");
    log_lines.push("values|path|p=PATH|e=@path|only commits that touch these paths (put it last)");
    cmds.push(make("log", "l", "log", "", "show the commit history", log_lines));
    List<str> show_lines = ["tail|objects|p=OBJECT|commits, tags, trees or blobs (default HEAD); REV:PATH is a file at a revision", "flag|oneline|e=--oneline|one line per commit", "value|format|p=STYLE|e=--format={}|a=--pretty={},--format {},--pretty {}|oneline, short, medium, full, fuller, raw, or a format such as '%h %s'", "value|date|p=STYLE|e=--date={}|how dates are shown: iso, short, relative, raw, unix, rfc, format:...", "int|abbrev|p=N|e=--abbrev={}|digits of an abbreviated commit name"];
    append(show_lines, diff_lines());
    show_lines.push("flag|header-only|s=s|e=-s|a=--no-patch|leave out the changes");
    show_lines.push("values|path|p=PATH|e=@path|only changes to these paths (put it last)");
    cmds.push(make("show", "", "show", "", "show commits, tags, trees and files", show_lines));
    List<str> diff_cmd_lines = ["tail|revisions|p=REV|none: work tree against index; one: work tree against it; two, or a..b: between them", "flag|staged|e=--staged|a=--cached|compare the index against HEAD (or against the revision)", "flag|exit-code|e=--exit-code|exit with 1 when there are differences", "flag|quiet|s=q|e=--quiet|a=-q|print nothing, and exit with 1 when there are differences"];
    append(diff_cmd_lines, diff_lines());
    diff_cmd_lines.push("values|path|p=PATH|e=@path|only changes to these paths (put it last)");
    cmds.push(make("diff", "d", "diff", "", "show changes between the work tree, the index and commits", diff_cmd_lines));
    // --- change --------------------------------------------------------------
    cmds.push(make("add", "a", "add", "", "stage changes", ["tail|paths|p=PATH|files and directories to stage ('.' is everything under here)", "flag|all|s=a|e=-A|a=--all|also stage deletions and new files everywhere", "flag|update|s=u|e=-u|a=--update|stage changes to files git already tracks, add no new ones", "flag|patch|s=p|e=-p|a=--patch|choose hunks to stage, interactively", "flag|force|s=f|e=-f|a=--force|add files that are ignored", "choice|executable|c=on=--chmod=+x,off=--chmod=-x|set or clear the executable bit on what is staged", "flag|dry-run|e=-n|a=--dry-run|show what would be staged", "flag|verbose|s=v|e=-v|a=--verbose|list each file staged"]));
    cmds.push(make("remove", "", "rm", "", "stop tracking files, and delete them", ["tail|paths|p=PATH|files to remove", "flag|keep-files|e=--cached|remove from the index only, keep the files", "flag|recursive|s=r|e=-r|allow directories", "flag|force|s=f|e=-f|a=--force|remove files that have changes", "flag|dry-run|e=-n|a=--dry-run|show what would be removed", "flag|quiet|s=q|e=-q|a=--quiet|print nothing", "flag|missing-ok|e=--ignore-unmatch|succeed when nothing matches"]));
    cmds.push(make("move", "", "mv", "", "move or rename files and directories", ["tail|paths|p=PATH|one or more sources, then the destination", "flag|force|s=f|e=-f|a=--force|overwrite an existing destination", "flag|dry-run|e=-n|a=--dry-run|show what would be moved", "flag|skip-errors|s=k|e=-k|skip sources that cannot be moved", "flag|verbose|s=v|e=-v|a=--verbose|list each file moved"]));
    cmds.push(make("restore", "", "restore", "", "put files back as they are in the index or in a commit", ["tail|paths|p=PATH|files and directories to restore", "value|from|p=REV|e=--source={}|a=-s {},--source {}|restore from this commit (default: the index, or HEAD with --staged)", "flag|staged|e=--staged|a=-S|restore the index", "flag|worktree|e=--worktree|a=-W|restore the work tree (the default unless --staged)", "flag|ours|e=--ours|take our side of a conflict", "flag|theirs|e=--theirs|take their side of a conflict", "flag|patch|s=p|e=-p|a=--patch|choose hunks to restore, interactively", "flag|quiet|s=q|e=-q|a=--quiet|print nothing"]));
    cmds.push(make("reset", "", "reset", "", "move the current branch to another commit", ["opt|target|p=REV|d=HEAD|the commit to move to", "choice|mode|e=--{}|c=soft,mixed,hard,keep|d=mixed|soft keeps index and files, mixed resets the index, hard also discards file changes, keep discards only what is safe", "flag|quiet|s=q|e=-q|a=--quiet|print nothing"]));
    cmds.push(make("commit", "c", "commit", "", "record the staged changes as a commit", ["values|message|s=m|p=TEXT|e=-m {}|a=--message={},--message {}|the message: each text is a paragraph", "value|file|s=F|p=FILE|e=-F {}|a=--file={},--file {}|read the message from a file ('-' is standard input)", "flag|all|s=a|e=-a|a=--all|stage changes to tracked files first", "flag|amend|e=--amend|replace the last commit", "choice|edit|c=on=--edit,off=--no-edit,on=-e|open the editor on the message (default: on, unless a message is given)", "flag|allow-empty|e=--allow-empty|allow a commit that changes nothing", "flag|allow-empty-message|e=--allow-empty-message|allow an empty message", "value|author|p=NAME <EMAIL>|e=--author={}|commit as this author", "value|date|p=DATE|e=--date={}|use this author date", "flag|reset-author|e=--reset-author|with --amend, take the author and date from now", "flag|signoff|s=s|e=-s|a=--signoff|add a Signed-off-by line", "value|fixup|p=REV|e=--fixup={}|a fixup commit for REV, for -rebase --autosquash", "value|squash|p=REV|e=--squash={}|a squash commit for REV, for -rebase --autosquash", "value|reuse-message|p=REV|e=-C {}|a=--reuse-message={},--reuse-message {}|reuse the message and author of a commit", "flag|skip-hooks|s=n|e=-n|a=--no-verify|do not run the pre-commit and commit-msg hooks", "flag|change-id|e=--change-id|add a Gerrit Change-Id line (or set gerrit.createChangeId)", "choice|cleanup|e=--cleanup={}|c=strip,whitespace,verbatim,scissors,default|how the message is cleaned up", "flag|dry-run|e=--dry-run|show what would be committed", "flag|quiet|s=q|e=-q|a=--quiet|print only errors", "values|path|p=PATH|e=@path|commit only the changes to these paths (put it last)"]));
    cmds.push(make("switch", "w", "switch", "", "change branch", ["opt|branch|p=BRANCH|the branch to switch to ('-' is the previous one)", "value|create|s=c|p=NAME|e=-c {}|a=--create={},--create {}|create this branch and switch to it", "value|force-create|p=NAME|e=-C {}|a=--force-create={},--force-create {}|create this branch, or reset it if it exists, and switch to it", "value|from|p=REV|e=@from|where the new branch starts (default: HEAD)", "flag|detach|s=d|e=--detach|switch to a commit, not to a branch", "flag|discard-changes|e=-f|a=--force,--discard-changes|throw local changes away", "flag|track|s=t|e=--track|a=-t|make the new branch track its start point", "flag|quiet|s=q|e=-q|a=--quiet|print nothing"]));
    cmds.push(make("checkout", "", "checkout", "", "switch branches or restore files, git's way (see -switch and -restore)", ["opt|target|p=REV|a branch or a revision to check out (default: stay)", "values|path|e=@path|restore only these paths from the target (put it last)", "value|create|s=b|p=NAME|e=-b {}|create a branch and switch to it", "value|reset-create|s=B|p=NAME|e=-B {}|create or reset a branch and switch to it", "flag|detach|s=d|e=--detach|a=-d|detach HEAD at the target", "flag|force|s=f|e=-f|a=--force|throw local changes away", "flag|ours|e=--ours|for paths in a merge: take our side", "flag|theirs|e=--theirs|for paths in a merge: take their side", "flag|track|s=t|e=--track|a=-t|set the upstream of a new branch", "flag|patch|s=p|e=-p|a=--patch|choose the hunks to restore", "flag|quiet|s=q|e=-q|a=--quiet|print nothing"]));
    cmds.push(make("branch", "b", "branch", "", "list, create, rename and delete branches", ["tail|patterns|p=PATTERN|list only branches matching these", "value|create|p=NAME|e=@create|create a branch", "value|from|p=REV|e=@from|where --create starts (default: HEAD)", "values|delete|p=NAME|e=-d|delete branches that are merged", "values|force-delete|p=NAME|e=-D|delete branches even when they are not merged", "values|rename|p=NAME|e=-m|rename a branch: NEW for the current one, or OLD NEW", "values|copy|p=NAME|e=-c|copy a branch: NEW for the current one, or OLD NEW", "flag|force|s=f|e=-f|a=--force|with --create, --rename or --copy: replace an existing branch", "value|set-upstream|p=REF|e=--set-upstream-to={}|a=-u {},--set-upstream-to {}|make the current branch track this remote branch", "flag|unset-upstream|e=--unset-upstream|stop the current branch tracking anything", "flag|track|s=t|e=--track|a=-t|with --create, track the start point", "flag|all|s=a|e=-a|a=--all|list local and remote branches", "flag|remotes|s=r|e=-r|a=--remotes|list remote branches", "flag|verbose|s=v|e=-v|a=--verbose|show the last commit of each branch", "flag|upstream|s=u|e=-vv|also show what each branch tracks", "flag|current|e=--show-current|print the name of the current branch", "value|contains|p=REV|e=--contains={}|a=--contains {}|only branches that contain this commit", "value|without|p=REV|e=--no-contains={}|a=--no-contains {}|only branches that do not contain this commit", "value|merged|p=REV|e=--merged={}|a=--merged {}|only branches merged into this commit", "value|unmerged|p=REV|e=--no-merged={}|a=--no-merged {}|only branches not merged into this commit", "value|points-at|p=REV|e=--points-at={}|a=--points-at {}|only branches at this commit", "value|sort|p=KEY|e=--sort={}|order by this key (refname, -refname, committerdate, ...)", "value|format|p=FORMAT|e=--format={}|print each branch in this format", "flag|ignore-case|s=i|e=-i|a=--ignore-case|sort and filter without regard to case"]));
    cmds.push(make("tag", "t", "tag", "", "list, create and delete tags", ["tail|patterns|p=PATTERN|list only tags matching these", "value|create|p=NAME|e=@create|create a tag", "value|from|p=REV|e=@from|what --create tags (default: HEAD)", "values|message|s=m|p=TEXT|e=-m {}|a=--message={}|an annotated tag with this message: each text is a paragraph", "value|file|s=F|p=FILE|e=-F {}|a=--file={}|an annotated tag with the message read from a file", "flag|annotate|s=a|e=-a|a=--annotate|an annotated tag, with the message from the editor", "values|delete|p=NAME|e=-d|delete tags", "flag|force|s=f|e=-f|a=--force|replace an existing tag", "value|contains|p=REV|e=--contains={}|a=--contains {}|only tags that contain this commit", "value|without|p=REV|e=--no-contains={}|a=--no-contains {}|only tags that do not contain this commit", "value|merged|p=REV|e=--merged={}|a=--merged {}|only tags merged into this commit", "value|unmerged|p=REV|e=--no-merged={}|a=--no-merged {}|only tags not merged into this commit", "value|points-at|p=REV|e=--points-at={}|a=--points-at {}|only tags at this commit", "value|sort|p=KEY|e=--sort={}|order by this key (refname, -refname, version:refname, ...)", "value|format|p=FORMAT|e=--format={}|print each tag in this format", "int|lines|s=n|p=N|e=-n{}|with the list, show this many lines of each annotation", "flag|ignore-case|s=i|e=-i|a=--ignore-case|sort and filter without regard to case"]));
    cmds.push(make("stash", "", "stash", "push", "put the changes away, leaving a clean work tree", ["value|message|s=m|p=TEXT|e=-m {}|a=--message={},--message {}|describe the stash", "flag|include-untracked|s=u|e=-u|a=--include-untracked|also stash untracked files", "flag|keep-index|s=k|e=--keep-index|a=-k|leave staged changes in the work tree", "flag|quiet|s=q|e=-q|a=--quiet|print nothing"]));
    cmds.push(make("stash-list", "", "stash", "list", "list the stashes", []));
    cmds.push(make("stash-show", "", "stash", "show", "show the changes in a stash", ["opt|entry|p=STASH|which stash: N or stash@{N} (default: the newest)", "flag|patch|s=p|e=-p|a=--patch|show the patch", "flag|stat|e=--stat|show a diffstat", "flag|name-only|e=--name-only|show the names of the changed files", "flag|name-status|e=--name-status|show the names, each with a letter for what happened", "flag|include-untracked|s=u|e=-u|a=--include-untracked|also show the untracked files"]));
    cmds.push(make("stash-apply", "", "stash", "apply", "apply a stash and keep it", ["opt|entry|p=STASH|which stash: N or stash@{N} (default: the newest)", "flag|restore-index|e=--index|also restore what was staged", "flag|quiet|s=q|e=-q|a=--quiet|print nothing"]));
    cmds.push(make("stash-pop", "", "stash", "pop", "apply a stash and drop it", ["opt|entry|p=STASH|which stash: N or stash@{N} (default: the newest)", "flag|restore-index|e=--index|also restore what was staged", "flag|quiet|s=q|e=-q|a=--quiet|print nothing"]));
    cmds.push(make("stash-drop", "", "stash", "drop", "delete one stash", ["opt|entry|p=STASH|which stash: N or stash@{N} (default: the newest)", "flag|quiet|s=q|e=-q|a=--quiet|print nothing"]));
    cmds.push(make("stash-clear", "", "stash", "clear", "delete every stash", []));
    // --- history ---------------------------------------------------------------
