    cmds.push(make("describe", "", "describe", "", "name a commit after the nearest tag", ["tail|commits|p=COMMIT|commits to name (default HEAD)", "flag|tags|e=--tags|use any tag, not only annotated ones", "flag|long|e=--long|always give the tag, the number of commits and the hash", "flag|always|e=--always|show the abbreviated hash when no tag fits", "flag|exact-match|e=--exact-match|only a tag on exactly this commit", "int|abbrev|p=N|e=--abbrev={}|digits of the hash (0: leave it out)", "values|match|p=GLOB|e=--match={}|only tags that match", "values|exclude|p=GLOB|e=--exclude={}|not tags that match"]));
    cmds.push(make("check-ignore", "", "check-ignore", "", "say which paths the ignore files ignore", ["tail|paths|p=PATH|the paths", "flag|quiet|s=q|e=-q|a=--quiet|print nothing, just the exit status", "flag|stdin|e=--stdin|read the paths from standard input", "flag|nul|s=z|e=-z|names end with NUL", "flag|no-index|e=--no-index|look at paths the index tracks too"]));
    cmds.push(make("blame", "", "blame", "", "show who last changed each line of a file", ["pos|file|p=FILE|the file", "opt|rev|p=REV|the revision to blame (default HEAD)", "flag|show-email|s=e|e=-e|a=--show-email|show the author email instead of the name", "flag|no-author|e=-s|suppress the author and the date", "flag|long|e=-l|the full commit name", "flag|show-name|s=f|e=-f|a=--show-name|show the file name of each line", "flag|show-number|s=n|e=-n|a=--show-number|show the line number in the original commit", "flag|raw-time|e=-t|show the time as seconds and zone", "flag|blank-boundary|e=-b|leave the name of boundary commits blank", "flag|root|e=--root|do not treat root commits as boundaries", "flag|porcelain|s=p|e=-p|a=--porcelain|a format for programs", "flag|line-porcelain|e=--line-porcelain|the porcelain format with the commit data on every line", "value|date|p=STYLE|e=--date={}|how dates are shown: iso, short, relative, unix, ...", "int|abbrev|p=N|e=--abbrev={}|digits of the commit name", "values|lines|s=L|p=RANGE|e=-L {}|only these lines: N,M or N,+K or ,M"]));
    cmds.push(make("annotate", "", "annotate", "", "blame, in the older format", ["pos|file|p=FILE|the file", "opt|rev|p=REV|the revision to blame (default HEAD)", "values|lines|s=L|p=RANGE|e=-L {}|only these lines: N,M or N,+K or ,M"]));
    cmds.push(make("grep", "", "grep", "", "search the files of the work tree, the index or trees for a pattern", ["opt|pattern|p=PATTERN|the pattern (basic regular expression); not needed when --regexp gives them", "tail|trees|p=REV|search these trees instead of the work tree", "values|path|e=@path|only these paths (put it last)", "values|regexp|s=e|p=PATTERN|e=-e {}|another pattern (any of them matches)", "values|also|p=PATTERN|e=--and -e {}|a pattern the same line must match too (with the last --regexp)", "flag|line-number|s=n|e=-n|a=--line-number|show the line numbers", "flag|ignore-case|s=i|e=-i|a=--ignore-case|ignore case", "flag|word|s=w|e=-w|a=--word-regexp|match whole words", "flag|invert|s=v|e=-v|a=--invert-match|lines that do not match", "flag|files-with-matches|s=l|e=-l|a=--files-with-matches,--name-only|only the names of files with a match", "flag|files-without-match|s=L|e=-L|a=--files-without-match|only the names of files without a match", "flag|count|s=c|e=-c|a=--count|the number of matching lines per file", "flag|no-filename|e=-h|do not show file names", "flag|with-filename|s=H|e=-H|show file names (the default)", "flag|extended|s=E|e=-E|a=--extended-regexp,-P,--perl-regexp|extended regular expressions", "flag|fixed|s=F|e=-F|a=--fixed-strings|the pattern is a plain string", "flag|only-matching|s=o|e=-o|a=--only-matching|print only the matching parts", "flag|quiet|s=q|e=-q|a=--quiet|print nothing, just the exit status", "int|after|s=A|p=N|e=--after-context={}|a=-A {},-A{}|lines after each match", "int|before|s=B|p=N|e=--before-context={}|a=-B {},-B{}|lines before each match", "int|context|s=C|p=N|e=--context={}|a=-C {},-C{},--context {}|lines around each match", "flag|cached|e=--cached|search the index, not the work tree", "flag|skip-binary|e=-I|do not search binary files", "flag|text|e=-a|a=--text|search binary files as text", "flag|nul|s=z|e=-z|a=--null|end file names with NUL", "flag|heading|e=--heading|file names above their matches", "flag|break|e=--break|an empty line between files", "int|max-depth|p=N|e=--max-depth={}|go down at most N directory levels", "flag|full-name|e=--full-name|file names from the top of the work tree"]));
    // --- plumbing -------------------------------------------------------------------
    cmds.push(make("cat-file", "", "cat-file", "", "print an object's type, size or contents", ["opt|first|p=TYPE or OBJECT|with two operands the type to print the object as (blob, tree, commit, tag), else the object", "opt|object|p=OBJECT|an object name, a prefix of one, a ref, HEAD:path, ...", "flag|type|s=t|e=-t|print the object's type word", "flag|size|s=s|e=-s|print the size of the object's content", "flag|pretty|s=p|e=-p|print the object in a readable form", "flag|exists|s=e|e=-e|print nothing; exit 0 when the object exists", "flag|batch|e=--batch|for each name read from standard input print its header and contents", "flag|batch-check|e=--batch-check|for each name read from standard input print its header", "value|batch-format|p=FORMAT|e=--batch={}|like --batch, with a format: %(objectname) %(objecttype) %(objectsize) %(rest)", "value|check-format|p=FORMAT|e=--batch-check={}|like --batch-check, with a format"]));
    cmds.push(make("ls-tree", "", "ls-tree", "", "list a tree's entries", ["pos|tree|p=TREE|a tree, or anything that names one: a commit, a tag, HEAD~2, v1:dir", "values|path|e=@path|only these paths (put it last)", "flag|recursive|s=r|e=-r|go into subtrees", "flag|trees|s=t|e=-t|with --recursive: show the trees too", "flag|only-trees|s=d|e=-d|show only the trees, not what is in them", "flag|long|s=l|e=-l|a=--long|show the size of each file", "flag|nul|s=z|e=-z|end each name with NUL, unquoted", "flag|names-only|e=--name-only|a=--name-status|show only the names", "flag|objects-only|e=--object-only|show only the object names", "int|abbrev|p=N|e=--abbrev={}|shorten the object names to this many digits", "flag|full-name|e=--full-name|names from the top of the tree (the default from the top)", "flag|full-tree|e=--full-tree|list the whole tree, not what is below the current directory"]));
    cmds.push(make("rev-parse", "", "rev-parse", "", "the object names a revision resolves to, and facts about the repository", ["tail|args|p=REV|revisions: a ref, an object name, HEAD~2, main^{tree}, v1:path, A..B, ...", "flag|git-dir|e=--git-dir|the git directory", "flag|absolute-git-dir|e=--absolute-git-dir|the git directory, absolute", "flag|git-common-dir|e=--git-common-dir|the directory shared by the linked work trees", "flag|toplevel|e=--show-toplevel|the top of the work tree", "flag|prefix|e=--show-prefix|where this directory is below the top, with a slash", "flag|cdup|e=--show-cdup|the way up to the top: ../..", "flag|inside-work-tree|e=--is-inside-work-tree|true or false", "flag|inside-git-dir|e=--is-inside-git-dir|true or false", "flag|bare|e=--is-bare-repository|true or false", "flag|shallow|e=--is-shallow-repository|true or false", "flag|verify|e=--verify|exactly one valid revision, or fail", "flag|quiet|s=q|e=-q|a=--quiet|with --verify: no message, just the status", "flag|short|e=--short|shorten the object names", "int|short-digits|p=N|e=--short={}|shorten the object names to this many digits", "flag|abbrev-ref|e=--abbrev-ref|a branch or tag by its short name", "flag|symbolic|e=--symbolic|print the names as given", "flag|symbolic-full-name|e=--symbolic-full-name|print the full ref names", "value|default|p=REV|e=--default={}|a revision to use when none is given", "flag|all|e=--all|every ref", "flag|branches|e=--branches|every branch", "flag|tags|e=--tags|every tag", "flag|remotes|e=--remotes|every remote-tracking branch", "flag|revs-only|e=--revs-only|only the revisions", "flag|no-revs|e=--no-revs|only what is not a revision", "flag|object-format|e=--show-object-format|sha1 or sha256", "value|git-path|p=PATH|e=--git-path={}|the path of a file in the git directory"]));
    cmds.push(make("refs", "", "refs", "", "every ref in the repository, with what it points at", []));
    cmds.push(make("migrate", "", "migrate", "", "write a git command line the 1git way", ["opt|line|p=LINE|a git command line, in quotes: 'git log --oneline -5'", "flag|nul|read git's words from standard input and write ours, NUL-separated (for scripts)"]));
    return cmds;
}
