// A commit, read-only: who and when, the message, and (given a path) what the
// commit did to that path against its first parent. Opened by Enter in the
// blame view and the file-history list. Scrolls with j / k, g / G.

import diff.GIT_hunks;
import core.GIT_object;
import core.GIT_pathtree;
import ui.GIT_ui_core;
import ui.GIT_ui_highlight;
import ui.GIT_ui_panel;
import ui.GIT_ui_sbs;
import ui.GIT_ui_sbs_state;
import date;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.widgets.TUI_diff_view;
import tui.core.TUI_geometry;

type ShowOverlay {
    GIT_ui_core.Core host;
    str title;
    List<str> lines;
    // The file the diff in `lines` is of ("" for none): its language.
    str path = "";
    int offset = 0;
    GIT_ui_highlight.DiffText syntax = GIT_ui_highlight.DiffText([]);
    bool is_syntax_ready = false;
    bool is_syntax_for_on = true;
    // The file's two sides, for the side-by-side drawing, and its state.
    bytes old = [];
    bytes new = [];
    int header_lines = 0;
    str old_label = "";
    str new_label = "";
    GIT_ui_sbs_state.SbsState split = GIT_ui_sbs_state.SbsState();
    bool is_split_built = false;
}

pub TUI_app.Action ShowOverlay.handle_key(term.Code code) {
    match (GIT_ui_core.lookup(GIT_ui_core.SCOPE_SHOW, code)) {
        case Some(str cmd): {
            if (cmd == GIT_ui_core.CMD_CLOSE) {
                host.pop_overlay();
            }
            if (cmd == GIT_ui_core.CMD_SYNTAX) {
                host.toggle_syntax();
            }
            if (cmd == GIT_ui_core.CMD_SPLIT) {
                GIT_ui_sbs.toggle_view_for(host, split.is_active, split.area_w + 2);
            }
            if (cmd == GIT_ui_core.CMD_WRAP) {
                GIT_ui_sbs.toggle_wrap_for(host, split);
            }
            // a side-by-side pane scrolls in its own rows
            int step = 0;
            if (cmd == GIT_ui_core.CMD_DOWN) {
                step = 1;
            }
            if (cmd == GIT_ui_core.CMD_UP) {
                step = -1;
            }
            if (split.is_active) {
                split.offset = split.offset + step;
                if (split.offset < 0) {
                    split.offset = 0;
                }
                if (cmd == GIT_ui_core.CMD_TOP) {
                    split.offset = 0;
                }
                if (cmd == GIT_ui_core.CMD_BOTTOM) {
                    split.offset = 1000000000;
                }
            } else {
                offset = offset + step;
                if (offset < 0) {
                    offset = 0;
                }
                if (cmd == GIT_ui_core.CMD_TOP) {
                    offset = 0;
                }
                if (cmd == GIT_ui_core.CMD_BOTTOM) {
                    offset = 1000000000;
                }
            }
            return TUI_app.Action.Redraw;
        }
        case None: {
        }
    }
    return TUI_app.Action.Continue;
}

pub void ShowOverlay.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_geometry.Rect inner = GIT_ui_panel.frame(buffer, area, title);
    if (inner.is_empty()) {
        return;
    }
    GIT_ui_sbs.load_preference(host);
    split.is_active = false;
    if (path != "" && GIT_ui_sbs.is_wanted(host.sbs.view, inner.width + 2)) {
        if (!is_split_built) {
            GIT_ui_sbs.set_file(split, lines.slice(0, header_lines), old, new, old_label, new_label);
            is_split_built = true;
        }
        if (GIT_ui_sbs.draw_pane(buffer, inner, split, GIT_ui_highlight.language_for_text(host.is_syntax_on, path), host.is_dark)) {
            split.is_active = true;
            return;
        }
    }
    offset = GIT_ui_panel.clamp(offset, lines.size(), inner.height);
    if (!is_syntax_ready || is_syntax_for_on != host.is_syntax_on) {
        syntax = GIT_ui_highlight.DiffText.shown(lines, GIT_ui_highlight.language_for_text(host.is_syntax_on, path), host.is_syntax_on);
        is_syntax_ready = true;
        is_syntax_for_on = host.is_syntax_on;
    }
    GIT_ui_panel.draw_text(buffer, inner, lines.size(), offset, -1, host.is_dark, syntax);
}

pub List<GIT_ui_core.Hint> ShowOverlay.hints() {
    return GIT_ui_core.hints_for(GIT_ui_core.SCOPE_SHOW);
}

/// "Name <email>  2023-11-14 22:13:20 +0000" for a commit's author line.
pub str ident_text(GIT_object.Ident who) {
    str name = who.name.utf8().or("?");
    str email = who.email.utf8().or("?");
    return name + " <" + email + ">  " + date.iso(who.when) + " " + who.zone;
}

/// The text of a commit view: the headers, the message, then the diff of
/// `path` ("" for none) against the first parent.
pub List<str> commit_lines(str gitdir, str commit_id, str path) {
    List<str> out = [];
    match (GIT_pathtree.read_commit(gitdir, commit_id)) {
        case Ok(GIT_object.Commit found): {
            return describe(gitdir, commit_id, found, path);
        }
        case Err(GIT_object.Error error): {
            return ["cannot read " + commit_id + ": " + error.to_str()];
        }
    }
}

List<str> describe(str gitdir, str commit_id, GIT_object.Commit commit, str path) {
    List<str> out = [];
    out.push("commit " + commit_id);
    out.push("Author: " + ident_text(commit.author));
    out.push("Commit: " + ident_text(commit.committer));
    for (str parent in commit.parents) {
        out.push("Parent: " + parent);
    }
    out.push("");
    for (str line in commit.message.utf8().or("(message is not UTF-8)").split("\n")) {
        out.push("    " + line);
    }
    if (path == "") {
        return out;
    }
    out.push("");
    out.push("--- " + path);
    bytes old = [];
    if (commit.parents.size() > 0) {
        old = blob_at(gitdir, commit.parents[0], path);
    }
    bytes new = blob_at(gitdir, commit_id, path);
    match (GIT_hunks.hunks(old, new)) {
        case Binary: {
            out.push("(binary file)");
        }
        case Hunks(List<TUI_diff_view.Hunk> hunks): {
            if (hunks.size() == 0) {
                out.push("(no change to this file)");
            }
            for (TUI_diff_view.Hunk hunk in hunks) {
                out.push(hunk.header);
                for (TUI_diff_view.Line line in hunk.lines) {
                    match (line.kind) {
                        case Context: {
                            out.push("  " + line.text);
                        }
                        case Add: {
                            out.push("+ " + line.text);
                        }
                        case Remove: {
                            out.push("- " + line.text);
                        }
                    }
                }
            }
        }
    }
    return out;
}

// The file's content in `commit_id`'s tree; empty when the commit has no such file.
bytes blob_at(str gitdir, str commit_id, str path) {
    match (GIT_pathtree.read_commit(gitdir, commit_id)) {
        case Ok(GIT_object.Commit commit): {
            match (GIT_pathtree.entry_at(gitdir, commit.tree, path)) {
                case Some(GIT_object.Entry entry): {
                    match (GIT_pathtree.blob(gitdir, entry.id)) {
                        case Ok(bytes content): {
                            return content;
                        }
                        case Err: {
                            return [];
                        }
                    }
                }
                case None: {
                    return [];
                }
            }
        }
        case Err: {
            return [];
        }
    }
}

/// Show `commit_id` (and its change to `path`, "" for none) over everything.
pub void open(GIT_ui_core.Core core, str commit_id, str path) {
    List<str> lines = commit_lines(core.gitdir, commit_id, path);
    ShowOverlay overlay = ShowOverlay(core, "commit " + commit_id.substr(0, 7), lines, path: path);
    if (path != "") {
        // the header is everything before the file's own "--- path" line
        int header_end = lines.size();
        for (int i in 0 .. lines.size()) {
            if (lines[i] == "--- " + path && header_end == lines.size()) {
                header_end = i;
            }
        }
        overlay.header_lines = header_end;
        match (GIT_pathtree.read_commit(core.gitdir, commit_id)) {
            case Ok(GIT_object.Commit commit): {
                if (commit.parents.size() > 0) {
                    overlay.old = blob_at(core.gitdir, commit.parents[0], path);
                }
                overlay.new = blob_at(core.gitdir, commit_id, path);
                overlay.old_label = path + "  (" + commit_id.substr(0, 7) + "^)";
                overlay.new_label = path + "  (" + commit_id.substr(0, 7) + ")";
            }
            case Err: {
            }
        }
    }
    core.push_overlay(overlay);
}

/// Show any text (a diff between two refs, say) over everything.
pub void open_text(GIT_ui_core.Core core, str title, List<str> lines) {
    core.push_overlay(ShowOverlay(core, title, lines));
}
