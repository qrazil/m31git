// The remote layer: the push (`P`) and pull (`F`) overlays and the two
// operations behind them, fast-forward only, over smart HTTP -- and over ssh
// when `origin` is an ssh URL (`GIT_ssh_transport.m31`), where an unknown host
// key stops at a confirm overlay (`HostTrustOverlay`) before anything is sent.

import core.GIT_branches;
import core.GIT_config;
import net.GIT_http_push;
import net.GIT_gitfetch;
import net.GIT_gitpush;
import net.GIT_gitremote;
import core.GIT_gitclean;
import core.GIT_gitworktree;
import ui.GIT_ui_prompt;
import io;
import os;
import net.GIT_pull;
import core.GIT_refs;
import diff.GIT_merge;
import diff.GIT_rebase;
import net.GIT_remote;
import net.GIT_ssh_transport;
import ui.GIT_ui_core;
import ui.GIT_ui_rebase;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.widgets.TUI_menu;

pub type RemoteLayer {
    pub GIT_ui_rebase.RebaseLayer;
}

/// This layer itself, for an overlay that drives everything up to the remote
/// layer (the overview's menus) and so cannot be handed only the `Core`.
pub RemoteLayer RemoteLayer.layer() {
    return this;
}

/// `P`: open the push overlay.
pub void RemoteLayer.open_push() {
    push_overlay(RemoteOverlay(this, true));
}

/// `F`: open the pull overlay.
pub void RemoteLayer.open_pull() {
    if (is_blocked_by_sequence("pull")) {
        return;
    }
    push_overlay(RemoteOverlay(this, false));
}

/// Push the current branch to the same-named branch on `origin`, over
/// smart HTTP, fast-forward only. The outcome -- success or the reason it
/// did not happen -- is the status line's message; a password is never part
/// of it (`GIT_http_push.parse_remote` strips it from the URL before anything
/// else sees the URL).
pub void RemoteLayer.push_current() {
    push_with(false);
}

/// `u` in the push menu: push, and on success make `origin/<branch>` the
/// branch's upstream (`git push -u`).
pub void RemoteLayer.push_set_upstream() {
    push_with(true);
}

// After a successful push git moves the remote-tracking ref to what was
// pushed (reflog "update by push"), and with `-u` writes branch.<n>.remote
// and branch.<n>.merge.
pub void RemoteLayer.push_with(bool should_set_upstream) {
    str refname = "";
    str id = "";
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str old_id): {
                    refname = name;
                    id = old_id;
                }
                case Unborn(str name): {
                    message = "push: " + name + " has no commits yet";
                    return;
                }
                case Detached(str old_id): {
                    message = "push: HEAD is detached; check out a branch first";
                    return;
                }
            }
        }
        case Err(GIT_refs.Error error): {
            message = "push: " + error.to_str();
            return;
        }
    }
    Option<str> url = GIT_config.get(gitdir, "remote", "origin", "url");
    if (!url.is_some()) {
        message = "push: no remote 'origin' in .git/config";
        return;
    }
    match (GIT_remote.parse(GIT_remote.rewrite_gitdir(gitdir, url.or(""), true))) {
        case Ok(GIT_remote.Remote ssh_remote): {
            if (ssh_remote.transport.eq(GIT_remote.Transport.Ssh)) {
                push_over_ssh(ssh_remote, refname, id, should_set_upstream);
                return;
            }
        }
        case Err(_): {
        }
    }
    GIT_http_push.Remote remote = GIT_http_push.Remote("", Option<GIT_http_push.Credentials>.None);
    match (GIT_http_push.parse_remote(url.or(""))) {
        case Ok(GIT_http_push.Remote parsed): {
            remote = parsed;
        }
        case Err(GIT_http_push.Error error): {
            message = "push: " + error.to_str();
            return;
        }
    }
    match (GIT_http_push.push(gitdir, remote, refname, id)) {
        case Ok(GIT_http_push.Report report): {
            if (report.is_ok) {
                message = "pushed " + refname + " to origin";
                log_command("push origin " + refname + " " + GIT_ui_core.short_id(id));
                record_pushed(refname, id, should_set_upstream);
            } else {
                message = "push refused by origin: " + report.reason;
            }
        }
        case Err(GIT_http_push.Error error): {
            message = "push: " + error.to_str();
        }
    }
    reload();
}

/// Pull the current branch from `origin`, fast-forward only (`GIT_pull.pull`):
/// refused on a dirty tree and on a diverged branch. The outcome is the
/// status line's message.
pub void RemoteLayer.pull_current() {
    Option<str> url = GIT_config.get(gitdir, "remote", "origin", "url");
    if (!url.is_some()) {
        message = "pull: no remote 'origin' in .git/config";
        return;
    }
    match (GIT_remote.parse(GIT_remote.rewrite_gitdir(gitdir, url.or(""), false))) {
        case Ok(GIT_remote.Remote ssh_remote): {
            if (ssh_remote.transport.eq(GIT_remote.Transport.Ssh)) {
                pull_over_ssh(ssh_remote);
                return;
            }
        }
        case Err(_): {
        }
    }
    GIT_http_push.Remote remote = GIT_http_push.Remote("", Option<GIT_http_push.Credentials>.None);
    match (GIT_http_push.parse_remote(url.or(""))) {
        case Ok(GIT_http_push.Remote parsed): {
            remote = parsed;
        }
        case Err(GIT_http_push.Error error): {
            message = "pull: " + error.to_str();
            return;
        }
    }
    match (GIT_pull.pull(gitdir, worktree, remote)) {
        case Ok(GIT_pull.Outcome outcome): {
            if (outcome.has_moved) {
                message = "pulled: fast-forwarded " + outcome.old_id.substr(0, 7) + ".." + outcome.new_id.substr(0, 7);
                log_command("pull origin " + GIT_ui_core.short_id(outcome.old_id) + ".." + GIT_ui_core.short_id(outcome.new_id));
            } else {
                message = "pull: already up to date";
            }
        }
        case Err(GIT_pull.Error error): {
            message = "pull: " + error.to_str();
            if (error.is_diverged()) {
                offer_pull("origin/" + current_branch_name());
            }
        }
    }
    reload();
}

// The bookkeeping after a push that origin accepted.
pub void RemoteLayer.record_pushed(str refname, str id, bool should_set_upstream) {
    str branch = refname.substr(11, refname.size());
    match (GIT_branches.record_push(gitdir, branch, "origin", id)) {
        case Ok(bool wrote): {
        }
        case Err(GIT_branches.Error error): {
            message = message + " (tracking ref: " + error.to_str() + ")";
        }
    }
    if (!should_set_upstream) {
        return;
    }
    match (GIT_branches.set_upstream(gitdir, branch, "origin", refname)) {
        case Ok(bool wrote): {
            message = message + "; upstream is origin/" + branch;
            log_command("branch --set-upstream-to origin/" + branch + " " + branch);
        }
        case Err(GIT_branches.Error error): {
            message = message + " (upstream: " + error.to_str() + ")";
        }
    }
}

// --- the library's own commands, on the terminal -------------------------------------

/// Ask for `fetch`, `pull` or `push` through the library's command (`1git`'s
/// own: upstream remote, credential helpers, netrc, askpass or a terminal
/// prompt, ssh known_hosts, git's reflog lines). The TUI cannot draw a
/// password prompt or git's progress, so this sets `is_editor_wanted` and the
/// loop in `mgit.m31` hands the terminal over, runs `run_net_now`, and
/// comes back; the status line then says how it ended.
pub void RemoteLayer.want_net(str verb, List<str> args) {
    want_net_then(verb, args, "");
}

/// `want_net`, then `after` ("merge" or "rebase") with the upstream it fetched.
/// The library's `pull` re-runs the `1git` executable for its merge or rebase,
/// which this program is not; so a pull here is the library's fetch followed
/// by this client's own merge and rebase, which keep the conflict view.
pub void RemoteLayer.want_net_then(str verb, List<str> args, str after) {
    if ((verb != "fetch" || after != "") && is_blocked_by_sequence("pull")) {
        return;
    }
    net_after = after;
    net_verb = verb;
    net_args = args;
    is_editor_wanted = true;
    message = verb + ": running on the terminal...";
}

/// The second half of `want_net`, with the terminal cooked and on the normal
/// screen. Prints one header line, runs the command, waits for Enter so
/// whatever it printed can be read, and leaves the outcome in the message.
/// Nothing here ever prints a credential: the library's lines carry URLs
/// with the password already removed (`GIT_transport.anonymize`).
pub void RemoteLayer.run_net_now() {
    str verb = net_verb;
    List<str> args = net_args;
    net_verb = "";
    net_args = [];
    if (verb == "") {
        return;
    }
    str shown = verb;
    if (args.size() > 0) {
        shown = verb + " " + args.join(" ");
    }
    io.eprint("mgit: running '" + shown + "' (Ctrl-C stops it)");
    int status = 0;
    if (verb == "fetch") {
        status = GIT_gitfetch.run_fetch(worktree, [], args);
    } else if (verb == "push") {
        status = GIT_gitpush.run_push(worktree, [], args);
    } else if (verb == "remote") {
        status = GIT_gitremote.run_remote(worktree, [], args);
    } else if (verb == "clean") {
        status = GIT_gitclean.run_clean(worktree, [], args);
    } else if (verb == "worktree") {
        status = GIT_gitworktree.run_worktree(worktree, [], args);
    } else if (verb == "sh") {
        status = 2;
        match (os.run(["sh", "-c", args[0]])) {
            case Ok(os.ExitStatus ran): {
                match (ran) {
                    case Exited(int code): {
                        status = code;
                    }
                    case Signaled(int sig): {
                        status = 128 + sig;
                    }
                }
            }
            case Err(_): {
            }
        }
    } else {
        status = 2;
    }
    if (status == 0) {
        io.eprint("mgit: '" + shown + "' finished");
    } else {
        io.eprint("mgit: '" + shown + "' failed (exit " + status.to_str() + ")");
    }
    // Leave the output on screen until Enter, so an error can be read; a remote
    // edit that worked has nothing to read.
    bool is_quiet_edit = (status == 0 && verb == "remote" && args.size() > 0 && args[0] != "prune") || (status == 0 && verb == "sh" && args.size() > 1 && args[1] == "nowait");
    if (!is_quiet_edit) {
        match (os.run(["sh", "-c", "printf 'press Enter to return to mgit ' >&2; read answer"])) {
            case Ok(_): {
            }
            case Err(_): {
            }
        }
    }
    str after = net_after;
    net_after = "";
    if (status == 0) {
        message = shown + ": done";
        log_command(shown);
    } else {
        message = shown + ": failed (exit " + status.to_str() + "); see the command's output -- @ has the log";
        after = "";
    }
    reload();
    if (after != "") {
        integrate_fetched(after);
    }
}

// After the fetch of a pull: what the upstream now holds goes into the branch.
// Level: nothing to do. Only behind: a fast-forward (or the rebase asked for).
// Diverged: the merge-or-rebase question, or what `pull.rebase` says.
pub void RemoteLayer.integrate_fetched(str how) {
    str branch = current_branch_name();
    if (branch == "") {
        message = "pull: HEAD is not on a branch";
        return;
    }
    match (GIT_branches.tracking(gitdir, branch)) {
        case Some(GIT_branches.Tracking tracking): {
            if (tracking.is_gone) {
                message = "pull: the upstream " + tracking.upstream + " does not exist on the remote";
                return;
            }
            if (tracking.behind == 0) {
                message = "pull: already up to date with " + tracking.upstream;
                return;
            }
            if (how == "rebase") {
                begin_rebase(GIT_rebase.PlanOpts(upstream: tracking.upstream), "rebase " + tracking.upstream);
                return;
            }
            if (tracking.ahead == 0) {
                start_merge(tracking.upstream, GIT_merge.FastForward.Only);
                return;
            }
            offer_pull(tracking.upstream);
        }
        case None: {
            message = "pull: " + branch + " has no upstream (push -u sets one)";
        }
    }
}

// --- over ssh ------------------------------------------------------------------------

// A refusal from the ssh transport as the status line's message -- or, for a
// host whose key is not known yet, the confirm overlay.
pub void RemoteLayer.ssh_stopped(str verb, GIT_ssh_transport.Error error, bool is_push) {
    match (error.pending_host()) {
        case Some(GIT_ssh_transport.PendingHost pending): {
            message = verb + ": " + pending.prompt();
            push_overlay(HostTrustOverlay(this, pending, is_push));
        }
        case None: {
            message = verb + ": " + error.to_str();
        }
    }
}

pub void RemoteLayer.push_over_ssh(GIT_remote.Remote remote, str refname, str id, bool should_set_upstream) {
    match (GIT_ssh_transport.target_for(remote)) {
        case Ok(GIT_ssh_transport.Target target): {
            match (GIT_ssh_transport.connect_receive(target)) {
                case Ok(GIT_ssh_transport.Receive receive): {
                    match (receive.push(gitdir, refname, id)) {
                        case Ok(GIT_ssh_transport.PushResult result): {
                            if (result.is_ok) {
                                message = "pushed " + refname + " to origin";
                                log_command("push origin " + refname + " " + GIT_ui_core.short_id(id));
                                record_pushed(refname, id, should_set_upstream);
                            } else {
                                message = "push refused by origin: " + result.reason + " " + result.remote;
                            }
                        }
                        case Err(GIT_ssh_transport.Error error): {
                            message = "push: " + error.to_str();
                        }
                    }
                }
                case Err(GIT_ssh_transport.Error error): {
                    ssh_stopped("push", error, true);
                    return;
                }
            }
        }
        case Err(GIT_ssh_transport.Error error): {
            message = "push: " + error.to_str();
            return;
        }
    }
    reload();
}

pub void RemoteLayer.pull_over_ssh(GIT_remote.Remote remote) {
    match (GIT_ssh_transport.target_for(remote)) {
        case Ok(GIT_ssh_transport.Target target): {
            match (GIT_pull.pull_ssh(gitdir, worktree, target)) {
                case Ok(GIT_pull.Outcome outcome): {
                    if (outcome.has_moved) {
                        message = "pulled: fast-forwarded " + outcome.old_id.substr(0, 7) + ".." + outcome.new_id.substr(0, 7);
                        log_command("pull origin " + GIT_ui_core.short_id(outcome.old_id) + ".." + GIT_ui_core.short_id(outcome.new_id));
                    } else {
                        message = "pull: already up to date";
                    }
                }
                case Err(GIT_pull.Error error): {
                    match (error.ssh_error()) {
                        case Some(GIT_ssh_transport.Error ssh_error): {
                            ssh_stopped("pull", ssh_error, false);
                            return;
                        }
                        case None: {
                            message = "pull: " + error.to_str();
                        }
                    }
                }
            }
        }
        case Err(GIT_ssh_transport.Error error): {
            message = "pull: " + error.to_str();
            return;
        }
    }
    reload();
}

// --- the overlays -----------------------------------------------------------------

/// One type serves both: `is_push` picks the table scope and the text.
type RemoteOverlay {
    RemoteLayer host;
    bool is_push;
}

pub TUI_app.Action RemoteOverlay.handle_key(term.Code code) {
    str scope = GIT_ui_core.SCOPE_PULL;
    if (is_push) {
        scope = GIT_ui_core.SCOPE_PUSH;
    }
    match (GIT_ui_core.lookup(scope, code)) {
        case Some(str cmd): {
            host.pop_overlay();
            if (cmd == GIT_ui_core.CMD_PUSH) {
                host.push_current();
            }
            if (cmd == GIT_ui_core.CMD_PUSH_UPSTREAM) {
                host.push_set_upstream();
            }
            if (cmd == GIT_ui_core.CMD_PULL) {
                host.pull_current();
            }
            if (cmd == GIT_ui_core.CMD_FETCH) {
                host.want_net("fetch", []);
            }
            if (cmd == GIT_ui_core.CMD_PULL_LIBRARY) {
                host.want_net_then("fetch", [], "merge");
            }
            if (cmd == GIT_ui_core.CMD_PULL_REBASE) {
                host.want_net_then("fetch", [], "rebase");
            }
            if (cmd == GIT_ui_core.CMD_PUSH_LIBRARY) {
                host.want_net("push", []);
            }
            if (cmd == GIT_ui_core.CMD_PUSH_LEASE) {
                host.want_net("push", ["--force-with-lease"]);
            }
            if (cmd == GIT_ui_core.CMD_PUSH_TAGS) {
                host.want_net("push", ["--tags"]);
            }
            if (cmd == GIT_ui_core.CMD_PUSH_OTHER) {
                GIT_ui_prompt.open(host.core(), this, "push-other", "push the current branch to remote");
            }
            if (cmd == GIT_ui_core.CMD_PUSH_DELETE) {
                GIT_ui_prompt.open(host.core(), this, "push-delete", "DELETE a branch on a remote (remote/branch)");
            }
            if (cmd == GIT_ui_core.CMD_FETCH_ALL) {
                host.want_net("fetch", ["--all"]);
            }
            if (cmd == GIT_ui_core.CMD_FETCH_PRUNE) {
                host.want_net("fetch", ["--prune"]);
            }
            if (cmd == GIT_ui_core.CMD_FETCH_TAGS) {
                host.want_net("fetch", ["--tags"]);
            }
            if (cmd == GIT_ui_core.CMD_FETCH_OTHER) {
                GIT_ui_prompt.open(host.core(), this, "fetch-other", "fetch remote");
            }
            if (host.is_editor_wanted) {
                return TUI_app.Action.Quit;
            }
            return TUI_app.Action.Redraw;
        }
        case None: {
        }
    }
    return TUI_app.Action.Continue;
}

/// The prompt's answer (`GIT_ui_prompt.Receiver`).
pub void RemoteOverlay.received(str purpose, str text) {
    str name = text.trim();
    if (name == "") {
        return;
    }
    if (purpose == "fetch-other") {
        host.want_net("fetch", [name]);
    }
    if (purpose == "push-other") {
        str branch = host.current_branch_name();
        if (branch == "") {
            host.say("push: HEAD is not on a branch");
            return;
        }
        host.want_net("push", [name, branch]);
    }
    if (purpose == "push-delete") {
        int slash = name.index_of("/").or(-1);
        if (slash <= 0 || slash >= name.size() - 1) {
            host.say("push --delete: type remote/branch, e.g. origin/old-topic");
            return;
        }
        host.want_net("push", [name.substr(0, slash), "--delete", name.substr(slash + 1, name.size())]);
    }
}

pub void RemoteOverlay.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_menu.WhichKey which_key = TUI_menu.WhichKey("pull", [TUI_menu.Item("p", "pull current branch from origin (fast-forward only)"), TUI_menu.Item("f", "fetch (terminal: progress, credential prompts)"), TUI_menu.Item("g", "pull with git's rules (merge or rebase per config)"), TUI_menu.Item("r", "pull --rebase"), TUI_menu.Item("a", "fetch every remote"), TUI_menu.Item("x", "fetch --prune"), TUI_menu.Item("t", "fetch --tags"), TUI_menu.Item("o", "fetch a remote you name")]);
    if (is_push) {
        which_key = TUI_menu.WhichKey("push", [TUI_menu.Item("p", "push current branch to origin (fast-forward only)"), TUI_menu.Item("u", "push and set origin/<branch> as the upstream"), TUI_menu.Item("g", "push with git's rules (terminal: credential prompts)"), TUI_menu.Item("f", "force-with-lease push"), TUI_menu.Item("t", "push all tags"), TUI_menu.Item("o", "push to a remote you name"), TUI_menu.Item("d", "delete a branch on a remote")]);
    }
    which_key.render(buffer, area);
}

pub List<GIT_ui_core.Hint> RemoteOverlay.hints() {
    if (is_push) {
        return GIT_ui_core.hints_for(GIT_ui_core.SCOPE_PUSH);
    }
    return GIT_ui_core.hints_for(GIT_ui_core.SCOPE_PULL);
}

/// An ssh host whose key is not in known_hosts: `y` records it and runs the
/// push or pull again (now checked against the file like any known host);
/// every other key cancels with nothing recorded and nothing sent.
type HostTrustOverlay {
    RemoteLayer host;
    GIT_ssh_transport.PendingHost pending;
    bool is_push;
}

pub TUI_app.Action HostTrustOverlay.handle_key(term.Code code) {
    host.pop_overlay();
    match (GIT_ui_core.lookup(GIT_ui_core.SCOPE_CONFIRM, code)) {
        case Some(str cmd): {
            if (cmd == GIT_ui_core.CMD_YES) {
                match (GIT_ssh_transport.trust_host(pending)) {
                    case Ok(_): {
                        if (is_push) {
                            host.push_current();
                        } else {
                            host.pull_current();
                        }
                    }
                    case Err(GIT_ssh_transport.Error error): {
                        host.say(error.to_str());
                    }
                }
                return TUI_app.Action.Redraw;
            }
        }
        case None: {
        }
    }
    host.say("host key not trusted; nothing was sent");
    return TUI_app.Action.Redraw;
}

pub void HostTrustOverlay.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_menu.WhichKey which_key = TUI_menu.WhichKey("host key " + pending.fingerprint() + " not known", [TUI_menu.Item("host", pending.spec()), TUI_menu.Item("y", "trust and add to known_hosts (" + pending.known_hosts + ")"), TUI_menu.Item("N", "any other key: do not trust")]);
    which_key.render(buffer, area);
}

pub List<GIT_ui_core.Hint> HostTrustOverlay.hints() {
    return [GIT_ui_core.Hint("y", "trust host key"), GIT_ui_core.Hint("any", "cancel")];
}
