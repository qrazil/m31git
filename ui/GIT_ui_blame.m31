// `B`: who last touched each line of a file. A full-screen overlay listing the
// file as `GIT_blame.blame` attributes it -- short id (a leading `^` marks a
// boundary line, one from the root commit), author, date, line number, text.
//
//   j / k / g / G   move the cursor
//   enter           the commit of the line under the cursor, with its change
//   ,               blame again as of that commit's first parent
//   backspace       back to the previous blame (closes when there is none)
//
// Also here: `target`, which works out which file and revision `B` and `H`
// mean from the diff view or the outline row under the cursor.

import diff.GIT_blame;
import core.GIT_object;
import core.GIT_pathtree;
import ui.GIT_ui_core;
import ui.GIT_ui_highlight;
import ui.GIT_ui_panel;
import ui.GIT_ui_show;
import ui.GIT_ui_model;
import date;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.widgets.TUI_outline;
import tui.core.TUI_style;
import ui.GIT_ui_syntax;
import tui.core.TUI_text;

/// What `B` / `H` act on: a revision ("HEAD", or a commit id) and a path.
pub type Target {
    pub str rev;
    pub str path;
}

/// The file the user is pointing at, or why there is none. The diff view wins
/// when open; else the outline row. A worktree or index file is looked up at
/// HEAD (blame and history are about committed content); a file under a
/// commit is looked up at that commit; an untracked file has no history.
pub Result<Target, str> target(GIT_ui_core.Core core) {
    if (core.is_diff_open) {
        str name = core.diff_path.utf8().or("");
        if (core.diff_section == "untracked") {
            return Result<Target, str>.Err("untracked file: nothing to blame yet");
        }
        if (core.diff_section == "commit") {
            return Result<Target, str>.Ok(Target(core.diff_rev, name));
        }
        return Result<Target, str>.Ok(Target("HEAD", name));
    }
    match (core.outline.current()) {
        case Some(TUI_outline.Row row): {
            str id = row.node.id;
            if (id.starts_with("untracked:")) {
                return Result<Target, str>.Err("untracked file: nothing to blame yet");
            }
            if (id.starts_with("unstaged:") || id.starts_with("staged:")) {
                match (core.paths.get(id)) {
                    case Some(bytes path): {
                        return Result<Target, str>.Ok(Target("HEAD", path.utf8().or("")));
                    }
                    case None: {
                    }
                }
            }
            if (id.starts_with("commit:") && id.contains(":file:")) {
                match (core.file_diffs.get(id)) {
                    case Some(GIT_ui_model.CommitFileDiff found): {
                        return Result<Target, str>.Ok(Target(GIT_ui_model.commit_in_row(id), found.path.utf8().or("")));
                    }
                    case None: {
                    }
                }
            }
        }
        case None: {
        }
    }
    return Result<Target, str>.Err("put the cursor on a file first");
}

/// Who and when, for the blame margin.
pub type Margin {
    pub str who;
    pub str day;
}

/// The author and day of a commit, read once per commit and kept.
pub Margin margin_of(str gitdir, Map<str, Margin> cache, str commit_id) {
    match (cache.get(commit_id)) {
        case Some(Margin known): {
            return known;
        }
        case None: {
        }
    }
    Margin made = Margin("?", "");
    match (GIT_pathtree.read_commit(gitdir, commit_id)) {
        case Ok(GIT_object.Commit commit): {
            made = Margin(commit.author.name.utf8().or("?"), date.iso(commit.author.when).substr(0, 10));
        }
        case Err(GIT_object.Error error): {
        }
    }
    cache.set(commit_id, made);
    return made;
}

// One earlier blame, kept so backspace can return to it.
type Frame {
    str rev;
    List<GIT_blame.Line> lines;
    int selected;
    int offset;
}

type BlameOverlay {
    GIT_ui_core.Core host;
    str path;
    str rev;
    List<GIT_blame.Line> lines;
    Map<str, Margin> margins = {};
    int selected = 0;
    int offset = 0;
    List<Frame> back = [];
    // Why the last key did nothing, shown in the title until the next key.
    str notice = "";
    // The file's lines for syntax colours, rebuilt when `lines` or the switch changes.
    GIT_ui_syntax.Highlighter syntax = GIT_ui_syntax.Highlighter("");
    bool is_syntax_ready = false;
    bool is_syntax_for_on = true;
}

pub TUI_app.Action BlameOverlay.handle_key(term.Code code) {
    notice = "";
    match (GIT_ui_core.lookup(GIT_ui_core.SCOPE_BLAME, code)) {
        case Some(str cmd): {
            if (cmd == GIT_ui_core.CMD_CLOSE) {
                host.pop_overlay();
            }
            if (cmd == GIT_ui_core.CMD_SYNTAX) {
                host.toggle_syntax();
            }
            if (cmd == GIT_ui_core.CMD_DOWN && selected < lines.size() - 1) {
                selected = selected + 1;
            }
            if (cmd == GIT_ui_core.CMD_UP && selected > 0) {
                selected = selected - 1;
            }
            if (cmd == GIT_ui_core.CMD_TOP) {
                selected = 0;
            }
            if (cmd == GIT_ui_core.CMD_BOTTOM) {
                selected = lines.size() - 1;
                if (selected < 0) {
                    selected = 0;
                }
            }
            if (cmd == GIT_ui_core.CMD_OPEN && lines.size() > 0) {
                GIT_ui_show.open(host, lines[selected].commit, lines[selected].path);
            }
            if (cmd == GIT_ui_core.CMD_REBLAME && lines.size() > 0) {
                reblame();
            }
            if (cmd == GIT_ui_core.CMD_BACK) {
                if (back.size() == 0) {
                    host.pop_overlay();
                } else {
                    Frame frame = back.pop();
                    rev = frame.rev;
                    lines = frame.lines;
                    is_syntax_ready = false;
                    selected = frame.selected;
                    offset = frame.offset;
                }
            }
            return TUI_app.Action.Redraw;
        }
        case None: {
        }
    }
    return TUI_app.Action.Continue;
}

// Blame the file again as of the first parent of the selected line's commit.
void BlameOverlay.reblame() {
    GIT_blame.Line line = lines[selected];
    match (GIT_pathtree.read_commit(host.gitdir, line.commit)) {
        case Ok(GIT_object.Commit commit): {
            if (commit.parents.size() == 0) {
                notice = line.commit.substr(0, 7) + " is a root commit, there is nothing before it";
                return;
            }
            reblame_at(commit.parents[0], line.path);
        }
        case Err(GIT_object.Error error): {
            notice = error.to_str();
        }
    }
}

void BlameOverlay.reblame_at(str parent, str file) {
    GIT_blame.Quiet quiet = GIT_blame.Quiet();
    match (GIT_blame.blame(host.gitdir, parent, file, quiet)) {
        case Ok(List<GIT_blame.Line> found): {
            back.push(Frame(rev, lines, selected, offset));
            rev = parent;
            lines = found;
            is_syntax_ready = false;
            selected = 0;
            offset = 0;
        }
        case Err(GIT_blame.Error error): {
            notice = "blame at " + parent.substr(0, 7) + ": " + error.to_str();
        }
    }
}

pub void BlameOverlay.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    str at_revision = "HEAD";
    if (rev != "HEAD") {
        at_revision = rev.substr(0, 7);
    }
    TUI_geometry.Rect inner = GIT_ui_panel.frame(buffer, area, "blame " + path + " @ " + at_revision + notice_suffix());
    if (inner.is_empty()) {
        return;
    }
    // Keep the cursor inside the window.
    if (selected < offset) {
        offset = selected;
    }
    if (selected >= offset + inner.height) {
        offset = selected - inner.height + 1;
    }
    offset = GIT_ui_panel.clamp(offset, lines.size(), inner.height);
    int number_width = lines.size().to_str().chars().size();
    if (lines.size() == 0) {
        GIT_ui_panel.draw_lines(buffer, inner, ["(empty file)"], 0, -1);
        return;
    }
    if (!is_syntax_ready || is_syntax_for_on != host.is_syntax_on) {
        List<str> texts = [];
        for (GIT_blame.Line line in lines) {
            texts.push(line.text.utf8().or("(not UTF-8)"));
        }
        str first = "";
        if (texts.size() > 0) {
            first = texts[0];
        }
        syntax = GIT_ui_highlight.highlighter_of(GIT_ui_highlight.language_for_text(host.is_syntax_on, path, first_line: first), texts);
        is_syntax_ready = true;
        is_syntax_for_on = host.is_syntax_on;
    }
    int row = 0;
    while (row < inner.height && offset + row < lines.size()) {
        int index = offset + row;
        TUI_style.Style over = TUI_style.Style();
        if (index == selected) {
            over = TUI_style.Style(attrs: TUI_style.REVERSE);
            buffer.fill(TUI_geometry.Rect(inner.x, inner.y + row, inner.width, 1), " ", over);
        }
        str prefix = TUI_text.truncate(margin_text(lines[index], index + 1, number_width), inner.width);
        int used = buffer.set_str(inner.x, inner.y + row, prefix, over, max: inner.width);
        str code = without_eol(lines[index].text.utf8().or("(not UTF-8)"));
        GIT_ui_syntax.draw(buffer, inner.x + used, inner.y + row, inner.width - used, code, syntax.classes(index), TUI_style.Style(), host.is_dark, over: over);
        row = row + 1;
    }
}

str BlameOverlay.notice_suffix() {
    if (notice == "") {
        return "";
    }
    return " -- " + notice;
}

// Everything before the code: "abc1234 who         2023-11-14   12 ".
str BlameOverlay.margin_text(GIT_blame.Line line, int number, int number_width) {
    Margin margin = margin_of(host.gitdir, margins, line.commit);
    str id = line.commit.substr(0, 7);
    if (line.is_boundary) {
        id = "^" + line.commit.substr(0, 6);
    }
    return id + " " + pad(margin.who, 12) + " " + margin.day + " " + pad_left(number.to_str(), number_width) + " ";
}

pub List<GIT_ui_core.Hint> BlameOverlay.hints() {
    return GIT_ui_core.hints_for(GIT_ui_core.SCOPE_BLAME);
}

// A file's line comes with its terminator; tui 0.9.1 draws a control character as its
// Control Picture, so the row would end in the symbol for a newline.
str without_eol(str text) {
    str out = text;
    if (out.ends_with("\n")) {
        out = out.substr(0, out.size() - 1);
    }
    if (out.ends_with("\r")) {
        out = out.substr(0, out.size() - 1);
    }
    return out;
}

// `text` cut or space-filled to exactly `width` columns.
str pad(str text, int width) {
    str out = TUI_text.truncate(text, width, ellipsis: "");
    while (TUI_text.width(out) < width) {
        out = out + " ";
    }
    return out;
}

str pad_left(str text, int width) {
    str out = text;
    while (TUI_text.width(out) < width) {
        out = " " + out;
    }
    return out;
}

/// Blame `path` as of `rev` and open the overlay on it; the message line says
/// why not when that fails.
pub void open(GIT_ui_core.Core core, str rev, str path) {
    GIT_blame.Quiet quiet = GIT_blame.Quiet();
    match (GIT_blame.blame(core.gitdir, rev, path, quiet)) {
        case Ok(List<GIT_blame.Line> lines): {
            core.push_overlay(BlameOverlay(core, path, rev, lines));
        }
        case Err(GIT_blame.Error error): {
            core.say("blame " + path + ": " + error.to_str());
        }
    }
}

/// `B` from the outline or the diff view.
pub void open_current(GIT_ui_core.Core core) {
    match (target(core)) {
        case Ok(Target found): {
            open(core, found.rev, found.path);
        }
        case Err(str why): {
            core.say("blame: " + why);
        }
    }
}
