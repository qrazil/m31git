// The interactive client's own state and logic, split out of `mgit.m31` so
// it is importable and unit-testable the way `t_status.m31`/`t_index_stage.m31`
// test `GIT_status.m31`/`GIT_index.m31` directly -- a top-level statement anywhere in
// an imported file is refused (`docs/reference.md` §2), so anything this
// program needs a test harness to call has to live here rather than in the
// `.m31` that actually runs the terminal loop.
//
// `mgit.m31` is the thin driver: parse a path off the command line, build a
// `State`, and hand it to `TUI_app.Loop` exactly as `tui's `browse.m31``
// hands its own `State` to the same loop. Everything a test needs --
// building the outline from a `GIT_status.Status`, staging or unstaging one
// path, stripping a commit message down to what git would actually commit --
// is a method or a free function here, callable with no terminal in sight.
//
// This module is the TOP of the client: `State` embeds the layer tower
// (`GIT_ui_core` ... `GIT_ui_remote`, see `GIT_ui_core.m31`'s header) and adds
// what only the whole client can do -- draw the frame, dispatch a key through
// the key table to the overlay on top of the stack or to the current view,
// and launch `$EDITOR`. The pure model (`build_outline`, `CommitFileDiff`,
// `strip_comment_lines`, ...) is in `GIT_ui_model.m31`.
//
// See `docs/design.md`'s "Starting the client" for the scope this
// implements: whole-file staging, a commit via an externally edited message
// file, and the outline/jump-list/which-key/footer wiring the locked design
// names, plus hunk-level staging in the diff view (`GIT_patch.m31`, the
// `git add -p`/`git reset -p` half that section named as the follow-up).
// Push/pull, checkout and rebase are each a named, deliberate gap there,
// not an oversight here.
//
// --- launching `$EDITOR`, and the terminal handoff that takes ---------------
//
// `lib/os.m31` gained `os.run`/`ExitStatus` (`docs/sys-layer.md`'s "Process
// launch", added the same day as this) after this client first shipped with
// only the on-disk contract below -- a message file at a known path
// (`COMMIT_EDITMSG`, git's own name), edited by *something*, read back and
// refused if empty after stripping comments. `os.run` is now that
// "something": the which-key overlay's `e` actually launches `$EDITOR` (`vi`
// if unset, real git's own fallback) on `commit_message_path`.
//
// The wrinkle `os.run`'s own header does not have to solve, and this client
// does: `os.run` leaves stdin/stdout/stderr untouched precisely so an
// interactive child can take over the real terminal, but this program has
// already put that terminal in raw mode with the alternate screen on
// (`TUI_app.Loop.run`'s own `enter`/`leave` sequences) -- the wrong mode for
// an editor expecting a normal, cooked terminal to draw on. `lib/term.m31`'s
// `Session` is exactly the value that knows how to undo that (`restore()`,
// idempotent, called from its own destructor), but `Loop.run` holds it in
// its own function scope and hands a caller only an `Action`
// (`Continue`/`Redraw`/`Quit`) -- there is no `Suspend` a `Handler` can ask
// for, and adding one to that enum would ripple through every `match` on
// `Action` in `tui`, which this task does not own.
//
// So `edit_message` does not call `os.run` itself. It sets `is_editor_wanted` and
// returns `Quit` from the which-key's `e`, which unwinds `Loop.run` exactly
// as a real quit would: the `Session` goes out of scope, its destructor
// calls `restore()`, and the terminal is back in the ORIGINAL cooked mode
// `raw()` snapshotted before it ever touched termios, alternate screen
// already turned off by the `leave` sequence `Loop.run` registered with
// `on_exit`. That is the drop half of "drop the Session and re-acquire
// `raw()` afterward" -- `mgit.m31`'s own top-level driver, watching
// `is_editor_wanted`, is what does both: it runs `os.run` for real now that the
// terminal is cooked and on the normal screen, calls `launch_editor` to
// interpret the result, and -- unless the loop actually asked to quit --
// calls `Loop.run` again. That is the re-acquire half: a fresh `raw()` call,
// and a first frame `Loop.run` always draws with `TUI_diff.full` rather than
// a diff against whatever the editor left on screen.
//
// `f` (finish) and `a` (abort) are untouched: `launch_editor` reuses
// `finish_commit` verbatim for a successful edit (exit 0, non-empty
// message), so the "same stripping/empty-message-refusal logic" runs from
// exactly one place either way. A nonzero exit or a signal is treated as a
// cancelled edit -- the commit overlay stays open and the message file is left
// alone, so `e` can be pressed again, `f` can still try to finish whatever
// is on disk, and `a` can still discard it. `os.run` itself returning `Err`
// -- no `$EDITOR`, no `vi`, nothing nowhere on `$PATH` -- falls back to
// exactly the original behaviour: the template is already on disk (written
// before the launch attempt, same as before), and the operator is told to
// edit it externally and press `f`.

import diff.GIT_sequencer;
import ui.GIT_ui_actions;
import ui.GIT_ui_blame;
import ui.GIT_ui_branch;
import ui.GIT_ui_commit;
import ui.GIT_ui_core;
import ui.GIT_ui_diff;
import ui.GIT_ui_filelog;
import ui.GIT_ui_help;
import ui.GIT_ui_keymap;
import ui.GIT_ui_modes;
import ui.GIT_ui_modeview;
import ui.GIT_ui_picker;
import ui.GIT_ui_scrub;
import ui.GIT_ui_highlight;
import ui.GIT_ui_lines;
import ui.GIT_ui_log;
import ui.GIT_ui_merge;
import ui.GIT_ui_merge_model;
import ui.GIT_ui_model;
import ui.GIT_ui_outline;
import ui.GIT_ui_overview;
import ui.GIT_ui_rebase;
import ui.GIT_ui_remote;
import ui.GIT_ui_sbs;
import ui.GIT_ui_search;
import ui.GIT_ui_sequencer;
import ui.GIT_ui_state;
import ui.GIT_ui_statusline;
import ui.GIT_ui_stash;
import ui.GIT_ui_tags;
import ui.GIT_ui_undo;
import io;
import os;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.core.TUI_mouse;
import tui.widgets.TUI_outline;
import tui.core.TUI_style;
import tui.core.TUI_text;
import tui.core.TUI_widget;

/// Everything the interactive client is showing and doing right now: the
/// whole layer tower in one value, held by `mgit.m31`'s top-level driver.
/// There is no mutable module state to put it in instead (reference §2).
pub type State {
    pub GIT_ui_remote.RemoteLayer;
}

/// A fresh client over the repository whose git directory is `gitdir` and
/// whose working tree is `worktree`. Call `reload()` before drawing it --
/// this constructor alone does no I/O, which is what makes it safe to build
/// in a test that never touches a real repository.
pub static State State.open(str gitdir, str worktree) {
    State state = State(GIT_ui_remote.RemoteLayer(GIT_ui_rebase.RebaseLayer(GIT_ui_merge.MergeLayer(GIT_ui_branch.BranchLayer(GIT_ui_commit.CommitLayer(GIT_ui_lines.LinesLayer(GIT_ui_diff.DiffLayer(GIT_ui_outline.OutlineLayer(GIT_ui_core.Core(gitdir, worktree))))))))));
    state.set_editor_paths();
    state.set_syntax(GIT_ui_highlight.is_enabled(gitdir), GIT_ui_highlight.is_dark_terminal());
    state.load_folds();
    state.load_signoff();
    state.load_notified();
    return state;
}

/// Actually launch `$EDITOR` (or `vi`) on `commit_message_path` and act on how it
/// ended -- called by `mgit.m31`'s driver after `TUI_app.Loop.run` has
/// returned with `is_editor_wanted` set, so the terminal `os.run`'s child
/// inherits is the real, cooked one, not the raw alternate screen this
/// program draws on.
///
/// Every `os.run` outcome the caller needs handled:
///
///   - exited 0: read `commit_message_path` back and try to finish the commit --
///     `finish_commit` is exactly "the same stripping/empty-message-refusal
///     logic that already exists", so this calls it rather than repeating
///     it, which also keeps `f`'s own behaviour the one place it is defined.
///   - exited nonzero, or killed by a signal: a cancelled edit, real git's
///     own treatment of an editor that did not report success (its own
///     "There was a problem with the editor" -- a signal, `^C` most often,
///     gets its own status line, a more unusual case worth naming
///     differently even though the outcome -- leave everything as it is --
///     is the same). the commit overlay stays open and the message file is left
///     untouched, so `e` can be pressed again, `f` can still try to finish
///     whatever is on disk right now, and `a` can still discard it.
///   - `os.run` itself failed (`Err`) -- no `$EDITOR`, no `vi`, nothing
///     found on `$PATH` -- there is no process to have run at all, so this
///     falls back to exactly the original, pre-`os.run` behaviour: the
///     template is already on disk (`edit_message` wrote it before setting
///     `is_editor_wanted`), and the operator is told to edit it externally.
pub void State.launch_editor() {
    is_editor_wanted = false;
    if (net_verb != "") {
        run_net_now();
        settle();
        return;
    }
    if (resolve_edit_path != "") {
        launch_resolve_editor();
        settle();
        return;
    }
    if (rebase_edit_path != "") {
        launch_rebase_editor();
        settle();
        return;
    }
    if (is_editor_for_branch) {
        is_editor_for_branch = false;
        launch_branch_editor();
        settle();
        return;
    }
    str editor = GIT_ui_model.editor_for(gitdir);
    match (os.run([editor, commit_message_path])) {
        case Ok(os.ExitStatus exit_status): {
            match (exit_status) {
                case Exited(int code): {
                    if (code == 0) {
                        finish_commit();
                    } else {
                        message = "editor '" + editor + "' exited " + code.to_str() + "; message left at " + commit_message_path + " -- e to edit again, f to finish, a to abort";
                    }
                }
                case Signaled(int sig): {
                    message = "editor '" + editor + "' was killed by signal " + sig.to_str() + "; message left at " + commit_message_path + " -- e to edit again, f to finish, a to abort";
                }
            }
        }
        case Err(io.Error error): {
            message = "cannot launch '" + editor + "' (" + error.to_str() + "); edit " + commit_message_path + " in another terminal, then press f to finish or a to abort";
        }
    }
    settle();
}

/// Close what an operation finished with, and act on what a picker chose.
/// Called after every key and after the editor handoff: an operation that
/// succeeds sets `is_overlay_done` (its overlay may still be needed if it
/// failed, so the overlay cannot just pop itself first), and a picker leaves
/// its choice in `picked_purpose` / `picked_item`.
pub void State.settle() {
    if (is_overlay_done) {
        is_overlay_done = false;
        if (has_overlay()) {
            pop_overlay();
        } else if (ui_mode == GIT_ui_modes.COMMIT) {
            go_mode(GIT_ui_modes.STATUS);
        }
    }
    settle_palette();
    settle_merge_picks();
    settle_rebase_picks();
    match (take_pick(GIT_ui_core.PICK_CHECKOUT)) {
        case Some(str name): {
            checkout_branch(GIT_ui_model.picked_name(name));
        }
        case None: {
        }
    }
    match (take_pick(GIT_ui_core.PICK_REMOTE_CHECKOUT)) {
        case Some(str item): {
            track_remote(GIT_ui_model.picked_name(item));
        }
        case None: {
        }
    }
    match (take_pick(GIT_ui_core.PICK_REMOTE_REF)) {
        case Some(str item): {
            GIT_ui_overview.show_remote_ref(core(), item);
        }
        case None: {
        }
    }
}

/// The hint row's text for `width` columns: the top overlay's own keys when
/// there is one, else the current mode's, in the order of the key table's
/// priorities, with a final "? more".
List<GIT_ui_core.Hint> State.hint_row(int width) {
    if (has_overlay()) {
        return GIT_ui_keymap.fit(active_hints(), width, false);
    }
    return GIT_ui_keymap.hint_row(ui_mode, current_view(), current_flow(), width);
}

/// What is under way and how to deal with it, for the message row when nothing
/// else is being said, in every mode: "REBASING (2 left): r to continue, skip
/// or abort". "" when nothing is under way.
str State.flow_banner() {
    if (is_rebasing) {
        return sequence_word + " (" + sequence_left.to_str() + " left): r to continue, skip, abort or edit the todo; commit, branch, merge and pull wait";
    }
    if (is_sequencing) {
        return sequence_word + " (" + sequence_left.to_str() + " left): A or V to continue, skip or abort; commit, branch, merge and pull wait";
    }
    if (is_merging) {
        return "MERGING: resolve the conflicts (Enter on an unmerged path), then commit; m to abort";
    }
    return "";
}

/// "diff" while a hunk diff has replaced the document, else "doc".
pub str State.current_view() {
    if (is_diff_open) {
        return GIT_ui_keymap.VIEW_DIFF;
    }
    return GIT_ui_keymap.VIEW_DOC;
}

/// "", "merge", "sequence" or "rebase": what is under way, for the table.
pub str State.current_flow() {
    return GIT_ui_keymap.flow_of(is_merging, is_sequencing, is_rebasing);
}

/// The frame, top to bottom: the tab bar, the statusline, the mode's body,
/// the message row and the hint row on the last row of the terminal. There is
/// no border: every row but the body is one line, and the body gets what is
/// left (nothing, if the terminal is too small to show it). Overlays are drawn
/// over the body, bottom of the stack first.
///
/// The body is one of: the outline (Status, History, Branches, Stash, with the
/// jump list beside it when toggled on), the hunk diff in its place (Status
/// and History, after `d` or Enter on a file), or the Commit panel.
pub void State.draw(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_style.Theme theme = TUI_style.Theme.plain;
    List<TUI_geometry.Rect> bands = TUI_geometry.rows(area, [TUI_geometry.Constraint.Length(1), TUI_geometry.Constraint.Length(1), TUI_geometry.Constraint.Fill(1), TUI_geometry.Constraint.Length(1), TUI_geometry.Constraint.Length(1)]);
    TUI_geometry.Rect tab_row = bands[0];
    TUI_geometry.Rect facts_row = bands[1];
    TUI_geometry.Rect main = bands[2];
    TUI_geometry.Rect message_row = bands[3];
    TUI_geometry.Rect hint_area = bands[4];
    body_x = main.x;
    body_y = main.y;
    body_w = main.width;
    body_h = main.height;
    GIT_ui_modeview.draw_tabs(core(), buffer, tab_row);
    draw_statusline(buffer, facts_row);
    if (ui_mode == GIT_ui_modes.COMMIT && !is_diff_open) {
        GIT_ui_modeview.draw_commit_panel(core(), buffer, main);
    } else if (is_diff_open) {
        draw_lines(buffer, main);
    } else {
        TUI_geometry.Rect outline_area = main;
        if (is_jump_shown) {
            List<TUI_geometry.Rect> columns = TUI_geometry.columns(main, [TUI_geometry.Constraint.Fill(1), TUI_geometry.Constraint.Length(28)]);
            outline_area = columns[0];
            outline.render(buffer, outline_area);
            TUI_widget.Block jump_block = TUI_widget.Block(title: "jump", borders: TUI_widget.Borders.Single);
            jump_block.render(buffer, columns[1]);
            jump.render(buffer, jump_block.inner(columns[1]));
        } else {
            outline.render(buffer, outline_area);
        }
        body_w = outline_area.width;
    }
    if (!message_row.is_empty()) {
        str said = status_line();
        if (said != "") {
            buffer.set_str(message_row.x, message_row.y, TUI_text.truncate(" " + said, message_row.width), theme.dim, max: message_row.width);
        } else if (flow_banner() != "") {
            buffer.set_str(message_row.x, message_row.y, TUI_text.truncate(" " + flow_banner(), message_row.width), TUI_style.Style(foreground: TUI_style.Colour.Indexed(1), attrs: TUI_style.BOLD), max: message_row.width);
        }
    }
    GIT_ui_modeview.draw_hints(buffer, hint_area, hint_row(hint_area.width));
    for (GIT_ui_core.Overlay overlay in overlays) {
        overlay.render(buffer, main);
    }
    GIT_ui_scrub.scrub(buffer);
}

/// The statusline, on the row under the tab bar: the branch (bold), what it
/// tracks, the operation under way (red), the stash count, the change counts
/// and the repository's name, from `facts` -- see `GIT_ui_statusline` for what
/// goes when the line is narrow.
void State.draw_statusline(TUI_buffer.Buffer buffer, TUI_geometry.Rect row) {
    int room = row.width - 2;
    if (room < 4 || row.height < 1) {
        return;
    }
    List<GIT_ui_statusline.Segment> kept = GIT_ui_statusline.fit(GIT_ui_statusline.segments(facts), room);
    int x = row.x + 1;
    int right = row.x + row.width - 1;
    for (int index in 0 .. kept.size()) {
        if (index > 0) {
            buffer.set_str(x, row.y, GIT_ui_statusline.SEPARATOR, TUI_style.Style(attrs: TUI_style.DIM), max: right - x);
            x = x + TUI_text.width(GIT_ui_statusline.SEPARATOR);
        }
        str text = TUI_text.truncate(kept[index].text, right - x);
        TUI_style.Style style = TUI_style.Style();
        if (kept[index].id == "branch") {
            style = TUI_style.Style(attrs: TUI_style.BOLD);
        } else if (kept[index].id == "op") {
            style = TUI_style.Style(foreground: TUI_style.Colour.Indexed(1), attrs: TUI_style.BOLD);
        } else if (kept[index].id == "repo") {
            style = TUI_style.Style(attrs: TUI_style.DIM);
        }
        buffer.set_str(x, row.y, text, style, max: right - x);
        x = x + TUI_text.width(text);
    }
}

/// One decoded event. A key goes to `handle_key` (Ctrl-P is the one key read
/// with its modifier: it opens the command palette); a mouse report is the
/// tab bar's, the outline's or the diff's; a paste and an unknown sequence are
/// ignored.
pub TUI_app.Action State.handle(term.Event event) {
    match (event) {
        case Key(term.Key key): {
            if (key.has_modifiers(term.CTRL) && key.code.to_str() == "p" && !has_overlay()) {
                return open_palette();
            }
            return handle_key(key.code);
        }
        case Mouse(term.Mouse mouse): {
            if (has_overlay()) {
                return TUI_app.Action.Continue;
            }
            if (did_click_tab(mouse)) {
                return TUI_app.Action.Redraw;
            }
            if (is_diff_open) {
                if (GIT_ui_sbs.handle_mouse(core(), mouse)) {
                    return TUI_app.Action.Redraw;
                }
                return TUI_app.Action.Continue;
            }
            if (ui_mode != GIT_ui_modes.COMMIT && did_use_outline_mouse(mouse)) {
                return TUI_app.Action.Redraw;
            }
            return TUI_app.Action.Continue;
        }
        case Paste(_): {
            return TUI_app.Action.Continue;
        }
        case Unknown(_): {
            return TUI_app.Action.Continue;
        }
    }
}

/// A left press on the tab bar switches to that tab's mode.
bool State.did_click_tab(term.Mouse mouse) {
    match (mouse.kind) {
        case Down(int button): {
            if (button != 0 || mouse.row - 1 != tab_y) {
                return false;
            }
            str target = GIT_ui_modes.mode_at(GIT_ui_modes.tab_layout(ui_mode, tab_w), mouse.col - 1 - tab_x);
            if (target == "") {
                return false;
            }
            message = "";
            go_mode(target);
            return true;
        }
        case ScrollUp: {
            return false;
        }
        case ScrollDown: {
            return false;
        }
        case ScrollLeft: {
            return false;
        }
        case ScrollRight: {
            return false;
        }
        case Drag(int button): {
            return false;
        }
        case Up(int button): {
            return false;
        }
        case Moved: {
            return false;
        }
    }
}

/// The wheel moves the outline's cursor and a press selects a row, as the
/// widget does it; true when something changed.
bool State.did_use_outline_mouse(term.Mouse mouse) {
    TUI_geometry.Rect area = TUI_geometry.Rect(body_x, body_y, body_w, body_h);
    int x = mouse.col - 1;
    int y = mouse.row - 1;
    TUI_mouse.Response response = TUI_mouse.Response.Ignored;
    match (mouse.kind) {
        case ScrollUp: {
            response = outline.handle_mouse(TUI_mouse.Gesture(TUI_mouse.Kind.ScrollUp, x, y), area);
        }
        case ScrollDown: {
            response = outline.handle_mouse(TUI_mouse.Gesture(TUI_mouse.Kind.ScrollDown, x, y), area);
        }
        case Down(int button): {
            if (button == 0) {
                response = outline.handle_mouse(TUI_mouse.Gesture(TUI_mouse.Kind.Press, x, y, button: button), area);
            }
        }
        case ScrollLeft: {
        }
        case ScrollRight: {
        }
        case Drag(int button): {
        }
        case Up(int button): {
        }
        case Moved: {
        }
    }
    match (response) {
        case Ignored: {
            return false;
        }
        case Changed: {
            jump.sync_from(outline);
            jump.follow(outline);
            return true;
        }
        case Activated: {
            jump.sync_from(outline);
            jump.follow(outline);
            return true;
        }
    }
}

// --- the modes ------------------------------------------------------------------

/// Switch to `target`. The cursor each mode had is remembered by row id and
/// restored; an open diff is closed (it belongs to the mode it was opened in).
/// Nothing is re-read from the repository: only the outline is cut again.
pub void State.go_mode(str target) {
    if (target == ui_mode || target == "") {
        return;
    }
    if (is_diff_open) {
        close_diff();
    }
    enter_mode(target);
}

/// Tab and Shift-Tab: the next or previous mode, wrapping.
void State.cycle_mode(bool is_forward) {
    message = "";
    if (is_forward) {
        go_mode(GIT_ui_modes.next(ui_mode));
    } else {
        go_mode(GIT_ui_modes.previous(ui_mode));
    }
}

/// `:` or Ctrl-P: the command palette, a picker over every action of every
/// mode (`GIT_ui_keymap.palette_items`). What it picks is run by
/// `settle_palette`.
TUI_app.Action State.open_palette() {
    List<str> items = [];
    for (GIT_ui_keymap.PaletteItem item in GIT_ui_keymap.palette_items()) {
        items.push(item.text);
    }
    GIT_ui_picker.open(core(), GIT_ui_core.PICK_PALETTE, "commands", items);
    return TUI_app.Action.Redraw;
}

/// Run what the palette picked: switch to the action's mode (and out of a
/// diff, if the action is the document's), then do it as its own key would.
void State.settle_palette() {
    match (take_pick(GIT_ui_core.PICK_PALETTE)) {
        case Some(str text): {
            for (GIT_ui_keymap.PaletteItem item in GIT_ui_keymap.palette_items()) {
                if (item.text == text) {
                    run_entry(item.entry, item.arg);
                    return;
                }
            }
        }
        case None: {
        }
    }
}

/// Run the action an entry names, from the palette.
void State.run_entry(GIT_ui_keymap.Entry entry, str arg) {
    if (!entry.is_in(ui_mode)) {
        go_mode(entry.home());
    }
    if (entry.view == GIT_ui_keymap.VIEW_DOC && is_diff_open) {
        close_diff();
    }
    if (entry.view == GIT_ui_keymap.VIEW_DIFF && !is_diff_open) {
        message = entry.label + ": open a diff first (d on a file)";
        return;
    }
    TUI_app.Action action = TUI_app.Action.Continue;
    if (entry.scope == GIT_ui_core.SCOPE_GLOBAL) {
        action = run_global_command(entry.cmd, arg);
    } else {
        action = run_in_mode(entry.scope, entry.cmd, arg);
    }
    match (action) {
        case Quit: {
            is_quit_wanted = true;
        }
        case Continue: {
        }
        case Redraw: {
        }
    }
}

/// A key goes to the overlay on top of the stack if there is one -- it takes
/// every key, bound or not -- and otherwise through the key table, offered
/// by the current mode: the mode's own scope (and the outline's), then the
/// keys that work everywhere. A key the table binds but this mode does not
/// offer says where it went instead of silently doing nothing.
pub TUI_app.Action State.handle_key(term.Code code) {
    if (!is_diff_open) {
        visual_anchor = -1;
    }
    if (has_overlay()) {
        GIT_ui_core.Overlay top = overlays[overlays.size() - 1];
        TUI_app.Action action = top.handle_key(code);
        settle();
        if (is_quit_wanted) {
            is_quit_wanted = false;
            return TUI_app.Action.Quit;
        }
        if (is_editor_wanted && rebase_edit_path != "") {
            return TUI_app.Action.Quit;
        }
        return action;
    }
    str name = code.to_str();
    str view = current_view();
    TUI_app.Action action = TUI_app.Action.Continue;
    bool is_handled = false;
    for (str scope in GIT_ui_keymap.scopes_for(ui_mode, view)) {
        if (is_handled) {
            break;
        }
        match (GIT_ui_core.lookup(scope, code)) {
            case Some(str cmd): {
                is_handled = true;
                match (GIT_ui_keymap.find(ui_mode, view, scope, cmd, current_flow())) {
                    case Some(GIT_ui_keymap.Entry entry): {
                        action = run_in_mode(scope, cmd, name);
                    }
                    case None: {
                        say_moved(view, scope, cmd, name);
                        action = TUI_app.Action.Redraw;
                    }
                }
            }
            case None: {
            }
        }
    }
    if (!is_handled) {
        match (GIT_ui_core.lookup(GIT_ui_core.SCOPE_GLOBAL, code)) {
            case Some(str cmd): {
                action = run_global_command(cmd, name);
            }
            case None: {
            }
        }
    }
    settle();
    if (is_editor_wanted && ui_mode == GIT_ui_modes.COMMIT) {
        return TUI_app.Action.Quit;
    }
    return action;
}

/// The keys told about in earlier sessions (`GIT_ui_state`) need no long
/// sentence again.
void State.load_notified() {
    for (str key in GIT_ui_state.load_notified()) {
        notified.set(key, true);
    }
}

/// A bound key this mode does not offer: name the mode that does. The first
/// time in a session it is a full sentence; after that, the short form.
void State.say_moved(str view, str scope, str cmd, str name) {
    match (GIT_ui_keymap.moved_to(ui_mode, view, scope, cmd)) {
        case Some(GIT_ui_keymap.Entry entry): {
            // Something is under way and this action waits for it: say that
            // rather than where the key went.
            if ((entry.when == "idle" || entry.when == "noseq") && is_blocked_by_sequence(entry.label)) {
                return;
            }
            str home = GIT_ui_modes.title(entry.home());
            if (notified.contains(name)) {
                message = name + ": " + home + " (" + (GIT_ui_modes.index_of(entry.home()) + 1).to_str() + ")";
            } else {
                notified.set(name, true);
                GIT_ui_state.save_notified(notified.keys());
                message = name + " moved to " + home + " (" + (GIT_ui_modes.index_of(entry.home()) + 1).to_str() + "): " + entry.label + ". Tab or " + (GIT_ui_modes.index_of(entry.home()) + 1).to_str() + " goes there; : lists every command";
            }
        }
        case None: {
        }
    }
}

/// Dispatch one command of `scope` to the code that does it.
TUI_app.Action State.run_in_mode(str scope, str cmd, str name) {
    if (scope == GIT_ui_core.SCOPE_DIFF) {
        return run_diff_command(cmd);
    }
    if (scope == GIT_ui_core.SCOPE_COMMIT) {
        return run_commit_command(cmd);
    }
    return run_outline_command(cmd, name);
}

/// The Commit mode's keys: the old commit overlay's `e`, `f`, `A` and `a`.
TUI_app.Action State.run_commit_command(str cmd) {
    if (cmd == GIT_ui_core.CMD_SIGNOFF) {
        toggle_signoff();
        return TUI_app.Action.Redraw;
    }
    if (cmd != GIT_ui_core.CMD_ABORT && is_blocked_by_sequence("commit")) {
        return TUI_app.Action.Redraw;
    }
    if (cmd == GIT_ui_core.CMD_EDIT) {
        edit_message();
        if (is_editor_wanted) {
            return TUI_app.Action.Quit;
        }
    }
    if (cmd == GIT_ui_core.CMD_FINISH) {
        finish_commit();
    }
    if (cmd == GIT_ui_core.CMD_AMEND) {
        start_amend();
    }
    if (cmd == GIT_ui_core.CMD_ABORT) {
        confirm_abort();
    }
    return TUI_app.Action.Redraw;
}

TUI_app.Action State.run_global_command(str cmd, str name) {
    if (cmd == GIT_ui_core.CMD_MODE_NEXT) {
        cycle_mode(true);
        return TUI_app.Action.Redraw;
    }
    if (cmd == GIT_ui_core.CMD_MODE_PREV) {
        cycle_mode(false);
        return TUI_app.Action.Redraw;
    }
    if (cmd == GIT_ui_core.CMD_MODE_GOTO) {
        message = "";
        go_mode(GIT_ui_modes.for_digit(name));
        return TUI_app.Action.Redraw;
    }
    if (cmd == GIT_ui_core.CMD_PALETTE) {
        return open_palette();
    }
    if (cmd == GIT_ui_core.CMD_LOG) {
        GIT_ui_log.open(core());
        return TUI_app.Action.Redraw;
    }
    if (cmd == GIT_ui_core.CMD_HELP) {
        GIT_ui_help.open(core());
        return TUI_app.Action.Redraw;
    }
    if (cmd == GIT_ui_core.CMD_SYNTAX) {
        toggle_syntax();
        return TUI_app.Action.Redraw;
    }
    if (cmd == GIT_ui_core.CMD_OVERVIEW) {
        GIT_ui_overview.open(layer());
        return TUI_app.Action.Redraw;
    }
    return TUI_app.Action.Continue;
}

TUI_app.Action State.run_diff_command(str cmd) {
    if (cmd == GIT_ui_core.CMD_DOWN) {
        move_lines(1);
    }
    if (cmd == GIT_ui_core.CMD_UP) {
        move_lines(-1);
    }
    if (cmd == GIT_ui_core.CMD_SECTION_PREVIOUS) {
        go_hunk(false);
    }
    if (cmd == GIT_ui_core.CMD_SECTION_NEXT) {
        go_hunk(true);
    }
    if (cmd == GIT_ui_core.CMD_SIBLING_PREVIOUS) {
        go_file(false);
    }
    if (cmd == GIT_ui_core.CMD_SIBLING_NEXT) {
        go_file(true);
    }
    if (cmd == GIT_ui_core.CMD_FOLD) {
        fold_hunk();
    }
    if (cmd == GIT_ui_core.CMD_FOLD_ALL) {
        fold_all_hunks(true);
    }
    if (cmd == GIT_ui_core.CMD_UNFOLD_ALL) {
        fold_all_hunks(false);
    }
    if (cmd == GIT_ui_core.CMD_STAGE) {
        stage_hunk_lines();
    }
    if (cmd == GIT_ui_core.CMD_UNSTAGE) {
        unstage_hunk_lines();
    }
    if (cmd == GIT_ui_core.CMD_VISUAL) {
        toggle_visual();
    }
    if (cmd == GIT_ui_core.CMD_LINES) {
        act_on_lines();
    }
    if (cmd == GIT_ui_core.CMD_DISCARD) {
        discard_lines();
    }
    if (cmd == GIT_ui_core.CMD_BACK) {
        back_lines();
    }
    if (cmd == GIT_ui_core.CMD_BLAME) {
        GIT_ui_blame.open_current(core());
    }
    if (cmd == GIT_ui_core.CMD_HISTORY) {
        GIT_ui_filelog.open_current(core());
    }
    run_split_command(cmd);
    return TUI_app.Action.Redraw;
}

// The side-by-side view's keys (`GIT_ui_sbs`); the ones that only mean
// something there say so when the unified view is up.
void State.run_split_command(str cmd) {
    if (cmd == GIT_ui_core.CMD_SPLIT) {
        GIT_ui_sbs.toggle_view(core());
        return;
    }
    if (!sbs.is_active) {
        if (cmd == GIT_ui_core.CMD_LEFT || cmd == GIT_ui_core.CMD_RIGHT || cmd == GIT_ui_core.CMD_WIDEN || cmd == GIT_ui_core.CMD_WIDEN_RESET || cmd == GIT_ui_core.CMD_WRAP || cmd == GIT_ui_core.CMD_SCROLL_LEFT || cmd == GIT_ui_core.CMD_SCROLL_RIGHT) {
            message = "that is for the side-by-side view (D)";
        }
        return;
    }
    if (cmd == GIT_ui_core.CMD_LEFT) {
        GIT_ui_sbs.focus(core(), false);
    }
    if (cmd == GIT_ui_core.CMD_RIGHT) {
        GIT_ui_sbs.focus(core(), true);
    }
    if (cmd == GIT_ui_core.CMD_WIDEN) {
        GIT_ui_sbs.widen(core(), false);
    }
    if (cmd == GIT_ui_core.CMD_WIDEN_RESET) {
        GIT_ui_sbs.widen(core(), true);
    }
    if (cmd == GIT_ui_core.CMD_WRAP) {
        GIT_ui_sbs.toggle_wrap(core());
    }
    if (cmd == GIT_ui_core.CMD_SCROLL_LEFT) {
        GIT_ui_sbs.scroll_h(core(), 0 - 8);
    }
    if (cmd == GIT_ui_core.CMD_SCROLL_RIGHT) {
        GIT_ui_sbs.scroll_h(core(), 8);
    }
}

/// `name` is the key's own name: the arrow keys always move the outline
/// cursor, even with the jump list focused, where `j` / `k` step the list.
TUI_app.Action State.run_outline_command(str cmd, str name) {
    if (cmd == GIT_ui_core.CMD_QUIT) {
        return TUI_app.Action.Quit;
    }
    if (cmd == GIT_ui_core.CMD_LEAVE) {
        if (ui_mode == GIT_ui_modes.STATUS) {
            return TUI_app.Action.Quit;
        }
        go_mode(GIT_ui_modes.STATUS);
        return TUI_app.Action.Redraw;
    }
    if (cmd == GIT_ui_core.CMD_DOWN) {
        if (name == "down") {
            move_cursor(1);
        } else {
            step_or_move(1);
        }
    }
    if (cmd == GIT_ui_core.CMD_UP) {
        if (name == "up") {
            move_cursor(-1);
        } else {
            step_or_move(-1);
        }
    }
    if (cmd == GIT_ui_core.CMD_LEFT) {
        outline.scroll_h(-GIT_ui_model.SCROLL_H_STEP);
    }
    if (cmd == GIT_ui_core.CMD_RIGHT) {
        outline.scroll_h(GIT_ui_model.SCROLL_H_STEP);
    }
    if (cmd == GIT_ui_core.CMD_TOGGLE) {
        handle_enter();
    }
    if (cmd == GIT_ui_core.CMD_SECTION_PREVIOUS) {
        go_section(false);
    }
    if (cmd == GIT_ui_core.CMD_SECTION_NEXT) {
        go_section(true);
    }
    if (cmd == GIT_ui_core.CMD_SIBLING_PREVIOUS) {
        go_sibling(false);
    }
    if (cmd == GIT_ui_core.CMD_SIBLING_NEXT) {
        go_sibling(true);
    }
    if (cmd == GIT_ui_core.CMD_FOLD) {
        fold_current();
    }
    if (cmd == GIT_ui_core.CMD_FOLD_ALL) {
        fold_everything(true);
    }
    if (cmd == GIT_ui_core.CMD_UNFOLD_ALL) {
        fold_everything(false);
    }
    if (cmd == GIT_ui_core.CMD_STAGE) {
        stage_current();
    }
    if (cmd == GIT_ui_core.CMD_UNSTAGE) {
        unstage_current();
    }
    if (cmd == GIT_ui_core.CMD_STAGE_ALL) {
        stage_all();
    }
    if (cmd == GIT_ui_core.CMD_UNSTAGE_ALL) {
        unstage_all();
    }
    if (cmd == GIT_ui_core.CMD_DIFF) {
        show_diff_current();
    }
    if (cmd == GIT_ui_core.CMD_DISCARD) {
        discard_current();
    }
    if (cmd == GIT_ui_core.CMD_COMMIT) {
        if (begin_commit()) {
            go_mode(GIT_ui_modes.COMMIT);
        }
    }
    if (cmd == GIT_ui_core.CMD_BRANCH) {
        open_branch();
    }
    if (cmd == GIT_ui_core.CMD_MERGE) {
        open_merge();
    }
    if (cmd == GIT_ui_core.CMD_REBASE) {
        open_rebase();
    }
    if (cmd == GIT_ui_core.CMD_PUSH) {
        open_push();
    }
    if (cmd == GIT_ui_core.CMD_PULL) {
        open_pull();
    }
    if (cmd == GIT_ui_core.CMD_JUMP) {
        is_jump_shown = !is_jump_shown;
    }
    if (cmd == GIT_ui_core.CMD_FOCUS) {
        is_jump_focused = !is_jump_focused;
    }
    if (cmd == GIT_ui_core.CMD_STASH) {
        GIT_ui_stash.open(core());
    }
    if (cmd == GIT_ui_core.CMD_SEARCH) {
        GIT_ui_search.open(core());
    }
    if (cmd == GIT_ui_core.CMD_NEXT) {
        GIT_ui_search.jump(core(), true, false);
    }
    if (cmd == GIT_ui_core.CMD_PREVIOUS) {
        GIT_ui_search.jump(core(), false, false);
    }
    if (cmd == GIT_ui_core.CMD_PICK) {
        GIT_ui_sequencer.open(core(), GIT_sequencer.Verb.Pick);
    }
    if (cmd == GIT_ui_core.CMD_REVERT) {
        GIT_ui_sequencer.open(core(), GIT_sequencer.Verb.Revert);
    }
    if (cmd == GIT_ui_core.CMD_REFRESH) {
        reload();
    }
    if (cmd == GIT_ui_core.CMD_BLAME) {
        GIT_ui_blame.open_current(core());
    }
    if (cmd == GIT_ui_core.CMD_HISTORY) {
        GIT_ui_filelog.open_current(core());
    }
    if (cmd == GIT_ui_core.CMD_UNDO) {
        GIT_ui_undo.open(core());
    }
    if (cmd == GIT_ui_core.CMD_TAGS) {
        GIT_ui_tags.open(core());
    }
    if (cmd == GIT_ui_core.CMD_BRANCH_DELETE) {
        GIT_ui_actions.delete_branch(core(), false);
    }
    if (cmd == GIT_ui_core.CMD_BRANCH_FORCE_DELETE) {
        GIT_ui_actions.delete_branch(core(), true);
    }
    if (cmd == GIT_ui_core.CMD_BRANCH_RENAME) {
        GIT_ui_actions.rename_branch(core());
    }
    if (cmd == GIT_ui_core.CMD_RESET) {
        GIT_ui_actions.open_reset(core());
    }
    if (cmd == GIT_ui_core.CMD_DETACH) {
        GIT_ui_actions.detach(core());
    }
    return TUI_app.Action.Redraw;
}

void State.step_or_move(int delta) {
    if (is_jump_focused && is_jump_shown) {
        jump.step(delta);
    } else {
        move_cursor(delta);
    }
}

/// `Enter` folds or unfolds the row under the cursor everywhere else
/// (`toggle_current`) -- a leaf row has nothing to fold, so that is already
/// a no-op on an author/date/message line. A commit's own file row is the
/// one leaf where `Enter` means something: pop its diff view directly,
/// the same one `d` opens for a staged/unstaged/untracked row, rather than
/// doing nothing. Checked by id, not by `r.node.has_children()`, so an
/// empty "Files changed (0)" section itself (there is nothing to diff a
/// merge whose first-parent diff touched no files) still just folds.
void State.handle_enter() {
    if (is_jump_focused && is_jump_shown) {
        jump.did_activate(outline);
        is_jump_focused = false;
        return;
    }
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            if (row.node.id.contains(":file:")) {
                show_diff_current();
                return;
            }
            if (row.node.id.starts_with(GIT_ui_merge_model.ROW_PREFIX)) {
                open_resolve_current();
                return;
            }
            if (row.node.id.starts_with("branch:")) {
                if (!is_blocked_by_sequence("branch")) {
                    checkout_current();
                }
                return;
            }
            if (row.node.id.starts_with("stash:")) {
                GIT_ui_stash.open_list(core(), GIT_ui_stash.target(core()));
                return;
            }
            if (row.node.id == GIT_ui_model.LOAD_MORE_ID) {
                log_limit = log_limit + GIT_ui_model.LOG_PAGE;
                reload();
                return;
            }
        }
        case None: {
        }
    }
    toggle_current();
}
