/// How many lines of the command log are kept; the oldest go first.
pub const int COMMAND_LOG_CAPACITY = 500;

/// One key, as the footer and the help overlay show it.
pub type Hint {
    pub str keys;
    pub str label;
}

/// One row of the key table. `keys` are `term.Code.to_str()` names ("j",
/// "enter", "escape", "S"); `help` is the sentence the help overlay shows;
/// `footer_keys`/`footer_label` are what an OVERLAY's hint row shows, with
/// `footer_keys == ""` meaning "help overlay only". The base scopes (outline,
/// diff, commit, everywhere) leave them empty: the hint row of a mode is
/// generated from `GIT_ui_keymap`, which also says which modes offer each key.
pub type Binding {
    pub str scope;
    pub str cmd;
    pub List<str> keys;
    pub str help;
    pub str footer_keys;
    pub str footer_label;
}

/// A modal layer over the document. Whichever overlay is last in
/// `Core.overlays` gets every key, and all of them draw, bottom to top.
pub interface Overlay {
    /// One decoded key. The overlay closes itself with `pop_overlay`.
    TUI_app.Action handle_key(term.Code code);
    /// Draw over `area` (the whole frame body).
    void render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area);
    /// The keys this overlay answers to, for the footer.
    List<Hint> hints();
}

/// Everything the interactive client is showing and doing right now. One
/// value, shared by every layer above it and by every overlay.
pub type Core {
    pub str gitdir;
    pub str worktree;
    pub TUI_outline.Outline outline = TUI_outline.Outline([]);
    pub TUI_jump_list.JumpList jump = TUI_jump_list.JumpList.empty;
    pub bool is_jump_shown = false;
    pub bool is_jump_focused = false;
    /// Syntax colours in every view that shows file text (see
    /// `GIT_ui_highlight`): set from `NO_COLOR`/`M31GIT_SYNTAX`/`mgit.syntax`
    /// at start, flipped by `C`.
    pub bool is_syntax_on = true;
    /// The terminal's background is dark (`$COLORFGBG`).
    pub bool is_dark = true;
    /// Set by an operation that finished the job the top overlay was opened
    /// for (`abort_commit`, `finish_commit`): the client pops that overlay
    /// when it next settles (`GIT_client.State.settle`). An operation that
    /// failed leaves it false, so the overlay stays open for a retry.
    pub bool is_overlay_done = false;
    /// The overlay stack: last is on top. Empty means the document has the keys.
    pub List<Overlay> overlays = [];
    /// `c` then `A`: the commit overlay is replacing HEAD rather than adding a
    /// child to it. `start_amend` sets this (and prefills the message file
    /// with HEAD's own message); `finish_commit` reads it to pick HEAD's
    /// parents and author instead of HEAD-as-parent and a fresh author.
    /// Reset whenever the overlay is opened fresh or aborted.
    pub bool is_amending = false;
    /// The Commit mode's sign-off toggle (`s`): add a `Signed-off-by:` trailer
    /// when the commit is made. Starts from `mgit.signoff`, off without it.
    pub bool is_signoff = false;
    /// Where `n` (new branch) asks for the name: a file `$EDITOR` is launched
    /// on, exactly like `commit_message_path`, since there is no text-input
    /// widget to type into -- see `new_branch`.
    pub str branch_name_path = "";
    /// Which file the pending `$EDITOR` launch is for -- `launch_editor`
    /// serves both the commit message and the new-branch name.
    pub bool is_editor_for_branch = false;
    pub List<GIT_ui_model.BranchRow> branch_rows = [];
    /// `stash@{n}: <message>` per stash, newest first -- the "Stashes" section.
    pub List<str> stash_labels = [];
    /// Set by `edit_message` and read by `mgit.m31`'s own top-level driver
    /// after `TUI_app.Loop.run` returns: true means the loop stopped so
    /// `$EDITOR` could have the terminal, not because the operator pressed
    /// `q`. See `GIT_client.m31`'s header, "launching `$EDITOR`".
    pub bool is_editor_wanted = false;
    /// A network command waiting for the terminal (`fetch`, `pull`, `push`):
    /// set with `is_editor_wanted`, run by `GIT_client.State.launch_editor`
    /// through the library's own command, so its progress, credential
    /// prompts and errors reach the real terminal. "" when none.
    pub str net_verb = "";
    pub List<str> net_args = [];
    /// What to do with the fetched upstream once a `net_verb` fetch is over:
    /// "" nothing, "merge" integrate as `F p` would, "rebase" rebase onto it.
    pub str net_after = "";
    pub str commit_message_path = "";
    pub str branch_label = "";
    /// What the statusline and the overview are drawn from: set by `refresh`.
    pub GIT_ui_statusline.Facts facts = GIT_ui_statusline.Facts();
    pub str message = "";
    /// Whether the primary document is currently showing a hunk-level diff
    /// instead of the outline -- see `show_diff_current`/`close_diff`.
    pub bool is_diff_open = false;
    /// Set instead of populating `diff_view`, when `GIT_hunks.hunks` reported
    /// `Binary` for the pair being compared.
    pub bool is_diff_binary = false;
    /// The row label the diff view's border is drawn with.
    pub str diff_title = "";
    pub TUI_diff_view.DiffView diff_view = TUI_diff_view.DiffView([]);
    /// The two files the open diff compares, and what the side-by-side view
    /// keeps about drawing them (`GIT_ui_sbs`).
    pub bytes diff_old = [];
    pub bytes diff_new = [];
    pub GIT_ui_sbs_state.SbsState sbs = GIT_ui_sbs_state.SbsState();
    /// Which comparison `diff_view` shows -- "untracked", "unstaged",
    /// "staged" or "commit" -- and for which path. Empty while closed.
    pub str diff_section = "";
    pub bytes diff_path = [];
    /// For a "commit" diff: the commit the file diff belongs to (40 hex), so
    /// `B` / `H` in the diff view know which revision to start from.
    pub str diff_rev = "";
    /// The outline row the open diff was opened from, so `{` / `}` can step
    /// to the neighbouring file. "" while no diff is open.
    pub str diff_row_id = "";
    pub Map<str, bool> collapsed = {};
    /// What `mgit.collapsed` last held (or was last written as), so a fold
    /// writes the repository's config only when the set of folded sections
    /// actually changed.
    pub str folded_saved = "";
    pub Map<str, bytes> paths = {};
    pub Map<str, GIT_ui_model.CommitFileDiff> file_diffs = {};
    /// `commit_changes`'s result per commit id, filled on demand the first
    /// time that commit is unfolded and never again: a commit is immutable.
    pub Map<str, List<GIT_ui_model.CommitFileDiff>> commit_changes_cache = {};
    /// How many commits `refresh` asks `GIT_log.walk` for.
    pub int log_limit = GIT_ui_model.LOG_PAGE;
    pub GIT_status.Status last_status = GIT_status.Status([], [], []);
    pub List<GIT_log.Entry> log = [];
    /// The `@` ring buffer: one line per write operation, oldest first.
    pub List<str> command_log = [];
    /// The last `/` query, for `n`/`N`.
    pub str search_query = "";
    /// What a finished picker was for and what it picked; the client reads and
    /// clears them after every key (`GIT_client.State.settle`).
    pub str picked_purpose = "";
    pub str picked_item = "";
    /// A merge is under way (`MERGE_HEAD` exists); set by `refresh`.
    pub bool is_merging = false;
    /// A cherry-pick or revert is under way; `sequence_word` is its banner
    /// (`CHERRY-PICKING` or `REVERTING`) and `sequence_left` the steps after
    /// the stopped one. Set by `refresh`.
    pub bool is_sequencing = false;
    pub str sequence_word = "";
    pub int sequence_left = 0;
    /// A rebase is under way; it also sets the three `sequence_` fields, so
    /// the banner and the blocking work as for a cherry-pick.
    pub bool is_rebasing = false;
    /// The file the conflict-resolution view asked `$EDITOR` for, and whether
    /// the editor ran since the view last read it (see `GIT_ui_merge`).
    pub str resolve_edit_path = "";
    pub bool is_resolve_dirty = false;
    /// Set by an action the command palette ran that ends the loop (quit, or
    /// `$EDITOR` wanting the terminal): the palette's picker has already closed
    /// when it runs, so `State.handle_key` returns `Quit` for it afterwards.
    pub bool is_quit_wanted = false;
    /// The current mode (`GIT_ui_modes`): which full-screen view has the keys.
    pub str ui_mode = "status";
    /// The outline row each mode's cursor was on when it was left, by mode.
    pub Map<str, str> mode_cursor = {};
    /// The keys whose "moved to ..." notice has been shown this session.
    pub Map<str, bool> notified = {};
    /// Where the last frame put the mode's body and the tab bar (absolute
    /// cells), for the mouse.
    pub int body_x = 0;
    pub int body_y = 0;
    pub int body_w = 0;
    pub int body_h = 0;
    pub int tab_x = 0;
    pub int tab_y = 0;
    pub int tab_w = 0;
}

pub void Core.push_overlay(Overlay overlay) {
    overlays.push(overlay);
}

/// Start-up: whether syntax colours are on, and whether the terminal is dark.
pub void Core.set_syntax(bool is_on, bool is_background_dark) {
    is_syntax_on = is_on;
    is_dark = is_background_dark;
}

/// `C`: syntax colours on or off for the rest of the session.
pub void Core.toggle_syntax() {
    is_syntax_on = !is_syntax_on;
    if (is_syntax_on) {
        message = "syntax colours on";
    } else {
        message = "syntax colours off";
    }
}

/// Close the top overlay. A no-op with none open.
pub void Core.pop_overlay() {
    if (overlays.size() > 0) {
        overlays.pop();
    }
}

pub bool Core.has_overlay() {
    return overlays.size() > 0;
}

/// The keys of the overlay on top, for the hint row; empty with none open --
/// then it is the current mode's row, from `GIT_ui_keymap` (which this layer
/// cannot import: the table is built on top of the key table below).
pub List<Hint> Core.active_hints() {
    if (overlays.size() > 0) {
        return overlays[overlays.size() - 1].hints();
    }
    return [];
}

/// The logging hook: record one write operation, one line. Called by the ops
/// that change the repository (`stage_path`, `finish_commit`, ...) right after
/// the engine call succeeded.
pub void Core.log_command(str line) {
    command_log.push(line);
    while (command_log.size() > COMMAND_LOG_CAPACITY) {
        command_log.remove_at(0);
    }
}

/// Re-read the repository: `GIT_status.status` for the three change lists,
/// `GIT_log.walk` for the commit history, and HEAD for the branch label the
/// status line shows. An unborn branch's `GIT_log.walk` failure is not an
/// error here -- it is exactly what "nothing committed yet" looks like --
/// so it becomes an empty history rather than a message.
pub void Core.refresh() {
    match (GIT_status.status(gitdir, worktree)) {
        case Ok(GIT_status.Status status): {
            last_status = status;
        }
        case Err(GIT_status.Error error): {
            last_status = GIT_status.Status([], [], []);
            message = "status: " + error.to_str();
        }
    }
    match (GIT_log.walk(gitdir, "HEAD", log_limit)) {
        case Ok(List<GIT_log.Entry> entries): {
            log = entries;
        }
        case Err: {
            log = [];
        }
    }
    is_merging = GIT_merge.is_in_progress(gitdir);
    is_sequencing = false;
    sequence_word = "";
    sequence_left = 0;
    match (GIT_sequencer.state(gitdir)) {
        case Some(GIT_sequencer.State found): {
            is_sequencing = true;
            sequence_word = GIT_sequencer.banner(gitdir);
            sequence_left = found.todo.size();
            if (found.is_stopped && sequence_left > 0) {
                sequence_left = sequence_left - 1;
            }
        }
        case None: {
        }
    }
    is_rebasing = false;
    match (GIT_rebase.state(gitdir)) {
        case Some(GIT_rebase.State found): {
            is_rebasing = true;
            is_sequencing = true;
            sequence_word = GIT_rebase.banner(gitdir);
            sequence_left = found.upcoming.size();
        }
        case None: {
        }
    }
    branch_rows = [];
    match (GIT_checkout.branches(gitdir)) {
        case Ok(List<GIT_checkout.Branch> branches): {
            List<str> names = [];
            for (GIT_checkout.Branch branch in branches) {
                names.push(branch.name);
            }
            // Upstream and ahead/behind, one config read and one graph for all.
            Map<str, GIT_branches.Tracking> found = GIT_branches.tracking_all(gitdir, names);
            for (GIT_checkout.Branch branch in branches) {
                GIT_ui_model.BranchRow row = GIT_ui_model.BranchRow(branch, tip_subject(branch.id));
                match (found.get(branch.name)) {
                    case Some(GIT_branches.Tracking tracking): {
                        row.upstream = tracking.upstream;
                        row.track = tracking.label();
                        row.ahead = tracking.ahead;
                        row.behind = tracking.behind;
                        row.is_gone = tracking.is_gone;
                    }
                    case None: {
                    }
                }
                branch_rows.push(row);
            }
        }
        case Err: {
        }
    }
    stash_labels = GIT_stash.labels(gitdir);
    facts = GIT_ui_statusline.Facts();
    facts.repo = repo_name();
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str id): {
                    facts.head_kind = "branch";
                    facts.branch = GIT_ui_model.branch_name(name);
                    facts.short_id = id.substr(0, 7);
                    branch_label = "on " + GIT_ui_model.branch_name(name) + " @ " + id.substr(0, 7) + track_suffix(GIT_ui_model.branch_name(name));
                }
                case Unborn(str name): {
                    facts.head_kind = "unborn";
                    facts.branch = GIT_ui_model.branch_name(name);
                    branch_label = "on " + GIT_ui_model.branch_name(name) + " (no commits yet)";
                }
                case Detached(str id): {
                    facts.head_kind = "detached";
                    facts.short_id = id.substr(0, 7);
                    branch_label = "detached @ " + id.substr(0, 7);
                }
            }
        }
        case Err(_): {
            branch_label = "?";
        }
    }
    if (is_sequencing) {
        branch_label = branch_label + "  " + sequence_word;
    }
    if (facts.head_kind == "branch") {
        for (GIT_ui_model.BranchRow row in branch_rows) {
            if (row.branch.name == facts.branch) {
                facts.upstream = row.upstream;
                facts.ahead = row.ahead;
                facts.behind = row.behind;
                facts.is_gone = row.is_gone;
            }
        }
    }
    facts.stashes = stash_labels.size();
    facts.staged = last_status.staged.size();
    facts.unstaged = last_status.unstaged.size();
    facts.untracked = last_status.untracked.size();
    facts.conflicts = last_status.unmerged.size();
    if (is_sequencing) {
        facts.operation = sequence_word;
        facts.steps_left = sequence_left;
    } else if (is_merging) {
        facts.operation = "MERGING";
    } else if (fs.is_present(fs.join(gitdir, "BISECT_LOG"))) {
        facts.operation = "BISECTING";
    }
}

/// The working tree's path as far as it is known: as given when absolute,
/// else under the physical current directory, else as
/// given. For the overview, and `repo_name`.
pub str Core.repo_path() {
    if (worktree.starts_with("/")) {
        return worktree;
    }
    str here = GIT_env.here();
    if (here == "" || !here.starts_with("/")) {
        return worktree;
    }
    if (worktree == "." || worktree == "") {
        return here;
    }
    return fs.join(here, worktree);
}

/// The repository's name for the statusline: the last segment of
/// `repo_path`, "" if there is none ("/" or an unknown directory).
pub str Core.repo_name() {
    List<str> parts = repo_path().split("/");
    int index = parts.size() - 1;
    while (index >= 0) {
        if (parts[index] != "" && parts[index] != ".") {
            return parts[index];
        }
        index = index - 1;
    }
    return "";
}

/// Read `mgit.signoff` (a git boolean) as the Commit mode's starting sign-off
/// setting; off when it is absent or not a boolean.
pub void Core.load_signoff() {
    match (GIT_config.effective(gitdir).get_bool("mgit", "", "signoff")) {
        case Some(bool is_on): {
            is_signoff = is_on;
        }
        case None: {
        }
    }
}

/// Read `mgit.collapsed` (a comma-separated list of root section ids) into
/// `collapsed`, so the sections folded in an earlier run start folded. Call
/// before the first `reload`.
pub void Core.load_folds() {
    // `mgit.collapsed`; `mgit.collapsed` is read when only the old key exists.
    Option<str> saved = GIT_config.get(gitdir, "mgit", "", "collapsed");
    match (saved) {
        case Some(_): {
        }
        case None: {
            saved = GIT_config.get(gitdir, "gitui", "", "collapsed");
        }
    }
    match (saved) {
        case Some(str value): {
            for (str id in GIT_ui_sections.parse_folded(value)) {
                collapsed.set(id, true);
            }
        }
        case None: {
        }
    }
    folded_saved = GIT_ui_sections.folded_roots(collapsed).join(",");
}

/// Write the folded root sections to `mgit.collapsed` when they changed
/// since last time; unset the key when none is folded. A repository whose
/// config cannot be written just does not remember.
pub void Core.persist_folds() {
    str now = GIT_ui_sections.folded_roots(collapsed).join(",");
    if (now == folded_saved) {
        return;
    }
    folded_saved = now;
    if (now == "") {
        match (GIT_config.unset(gitdir, "mgit", "", "collapsed")) {
            case Ok(_): {
            }
            case Err(_): {
            }
        }
        match (GIT_config.unset(gitdir, "gitui", "", "collapsed")) {
            case Ok(_): {
            }
            case Err(_): {
            }
        }
        return;
    }
    match (GIT_config.set(gitdir, "mgit", "", "collapsed", now)) {
        case Ok(_): {
        }
        case Err(_): {
        }
    }
    // Drop a leftover old-name key so it cannot resurrect the folds.
    match (GIT_config.unset(gitdir, "gitui", "", "collapsed")) {
        case Ok(_): {
        }
        case Err(_): {
        }
    }
}

/// True, with a message, while a cherry-pick or revert is under way: `what`
/// would change HEAD or the tree under it. The caller returns without acting.
pub bool Core.is_blocked_by_sequence(str what) {
    if (!is_sequencing) {
        return false;
    }
    str keys = "A or V";
    if (is_rebasing) {
        keys = "r";
    }
    message = what + " is blocked while " + sequence_word + " (" + keys + ": continue, skip or abort)";
    return true;
}

// " [ahead 2, behind 1]" for the header, "" when level or without upstream.
pub str Core.track_suffix(str name) {
    for (GIT_ui_model.BranchRow row in branch_rows) {
        if (row.branch.name == name && row.track != "") {
            return " " + row.track;
        }
    }
    return "";
}

/// Make sure `commit_changes_cache` has an entry for commit `id` -- computed
/// now if it is the first time this commit is unfolded, a no-op afterwards.
/// A commit whose tree or parent's tree cannot be read (a truncated history,
/// a shallow clone's boundary) gets an empty file list rather than failing
/// the unfold. Answers whether anything new was computed, so the caller knows
/// the outline it is looking at was built without this commit's files and
/// needs rebuilding.
pub bool Core.did_compute_commit_changes(str id) {
    if (commit_changes_cache.contains(id)) {
        return false;
    }
    for (GIT_log.Entry entry in log) {
        if (entry.id == id) {
            match (GIT_ui_model.commit_changes(gitdir, entry.commit)) {
                case Ok(List<GIT_ui_model.CommitFileDiff> changes): {
                    commit_changes_cache.set(id, changes);
                }
                case Err: {
                    commit_changes_cache.set(id, []);
                }
            }
            return true;
        }
    }
    return false;
}

/// Refresh and rebuild the outline, keeping the cursor on the row it was on
/// (by id, not by position -- `TUI_outline.m31`'s own reason) and the jump
/// list in step with it. Called after every action that changes what the
/// repository looks like: staging, unstaging, committing, and the manual
/// refresh key.
pub void Core.reload() {
    str keep_id = "";
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            keep_id = row.node.id;
        }
        case None: {
        }
    }
    refresh();
    rebuild_outline();
    if (keep_id != "") {
        outline.did_select_id(keep_id);
    }
    jump.sync_from(outline);
    jump.follow(outline);
}

/// Make `target` the current mode: remember the cursor row of the one being
/// left (by id), cut the outline for the new one and put its cursor back. The
/// repository is not re-read. A diff must already be closed (`State.go_mode`
/// does that); anything that needs another mode's rows -- the overview's
/// "Changes" -- calls this first.
pub void Core.enter_mode(str target) {
    if (target == ui_mode || target == "") {
        return;
    }
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            mode_cursor.set(ui_mode, row.node.id);
        }
        case None: {
        }
    }
    ui_mode = target;
    rebuild_outline();
    str keep = mode_cursor.get(ui_mode).or("");
    if (keep != "") {
        outline.did_select_id(keep);
    }
    jump.sync_from(outline);
    jump.follow(outline);
}

/// Build the outline again from what `refresh` last read: every section, the
/// conflict banners in front, cut down to what the current mode shows. The
/// cursor goes back to the top; the caller restores it.
pub void Core.rebuild_outline() {
    TUI_outline.Outline whole = GIT_ui_model.build_outline(last_status, log, commit_changes_cache, collapsed, paths, file_diffs, branch_rows, stashes: stash_labels);
    List<TUI_outline.Node> roots = GIT_ui_merge_model.merge_roots(last_status, is_merging, collapsed, paths, sequence_word, sequence_left);
    for (TUI_outline.Node node in whole.roots) {
        roots.push(node);
    }
    whole.roots = GIT_ui_modes.roots_for(ui_mode, roots);
    outline = whole;
}

/// `tip`'s first message line, for a branch row's label -- `""` if the commit
/// cannot be read (a ref pointing at something this cannot parse is shown by
/// name and id alone rather than hidden).
pub str Core.tip_subject(str tip) {
    match (GIT_object.read(gitdir, tip)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Commit(GIT_object.Commit commit): {
                    return GIT_ui_model.first_line(commit.message);
                }
                case Blob: {
                    return "";
                }
                case Tree(_): {
                    return "";
                }
                case Tag: {
                    return "";
                }
            }
        }
        case Err: {
            return "";
        }
    }
}

/// What the message row shows: the last message. (The branch, upstream and
/// the rest are the statusline on the frame's top border, from `facts`.)
pub str Core.status_line() {
    return message;
}

/// Set the status-line message. For overlays, which hold a layer and cannot
/// assign a promoted field from outside the type.
pub void Core.say(str text) {
    message = text;
}

/// The `Core` itself, for passing to an overlay that holds only a `Core`
/// (the embedded value is not reachable as a field).
pub Core Core.core() {
    return this;
}

/// Remember the search query (`/` and `n` / `N` read it back).
pub void Core.set_search(str query) {
    search_query = query;
}

/// The picker's answer: what the pick was for and the item chosen. The top
/// module's `settle` reads it and does the work (`PICK_CHECKOUT` checks the
/// branch out), so the picker stays ignorant of what it is picking for.
pub void Core.finish_pick(str purpose, str item) {
    picked_purpose = purpose;
    picked_item = item;
}

/// Take the picker's answer, leaving none behind.
pub Option<str> Core.take_pick(str purpose) {
    if (picked_purpose == purpose && picked_item != "") {
        str item = picked_item;
        picked_purpose = "";
        picked_item = "";
        return Option<str>.Some(item);
    }
    return Option<str>.None;
}

/// Point the two `$EDITOR` files at their places in the git directory: the
/// commit message (`COMMIT_EDITMSG`, git's own name) and the new branch's name.
pub void Core.set_editor_paths() {
    commit_message_path = fs.join(gitdir, "COMMIT_EDITMSG");
    branch_name_path = fs.join(gitdir, "MGIT_BRANCH_NAME");
}

// --- the key table ------------------------------------------------------------

/// The table. Order matters: it is the order of the footer and of the help
/// overlay. A function, not a module-level value, because m31 has no
/// module-level mutable state and building 60 small values per keypress is
/// nothing.
pub List<Binding> key_table() {
    List<Binding> table = [];
    // The document: the outline.
    table.push(Binding(SCOPE_OUTLINE, CMD_DOWN, ["j", "down"], "move the cursor down (steps the jump list when it has focus)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_UP, ["k", "up"], "move the cursor up", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_RIGHT, ["l", "right"], "scroll the outline right", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_LEFT, ["h", "left"], "scroll the outline left", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_SECTION_PREVIOUS, ["["], "jump to the previous section header (first to the top of this section)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_SECTION_NEXT, ["]"], "jump to the next section header", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_SIBLING_PREVIOUS, ["{"], "jump to the previous row at this depth or shallower (the previous commit, file or section)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_SIBLING_NEXT, ["}"], "jump to the next row at this depth or shallower", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_FOLD, ["space"], "fold or unfold the row; on a leaf fold its section and move to it", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_FOLD_ALL, ["-"], "fold every section", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_UNFOLD_ALL, ["+", "="], "unfold every section (commits stay as they are: Enter opens one)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_TOGGLE, ["enter"], "fold or unfold the row; open a commit's file diff; load more commits", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_STAGE, ["s"], "stage the file under the cursor", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_UNSTAGE, ["u"], "unstage the file under the cursor", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_STAGE_ALL, ["S"], "stage everything: every unstaged and untracked file", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_UNSTAGE_ALL, ["U"], "unstage everything", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_DIFF, ["d"], "open the hunk-level diff of the row", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_DISCARD, ["x"], "discard the changes to the file under the cursor (asks first)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_COMMIT, ["c"], "commit: the commit overlay (edit message, finish, amend)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_BRANCH, ["b"], "branch: check out, new branch", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_PUSH, ["P"], "push the current branch to origin (fast-forward only)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_PULL, ["F"], "pull the current branch from origin (fast-forward only)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_STASH, ["z"], "stash: push, pop, apply, drop, list (the stash under the cursor in the Stashes section, else the newest)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_BLAME, ["B"], "blame the file under the cursor: who last changed each line", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_HISTORY, ["H"], "history of the file under the cursor (git log -- path)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_UNDO, ["Z"], "undo the last HEAD move from the reflog (asks first; redo from there)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_TAGS, ["T"], "tags: list, create (lightweight or annotated), delete", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_BRANCH_DELETE, ["D"], "delete the branch under the cursor, if it is merged (git branch -d); never the branch you are on", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_BRANCH_FORCE_DELETE, ["X"], "delete the branch under the cursor even if it is not merged (git branch -D); asks first", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_BRANCH_RENAME, ["e"], "rename the branch under the cursor (git branch -m); asks before replacing a branch that exists", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_RESET, ["G"], "reset the current branch to the commit under the cursor: soft, mixed or hard (a hard reset asks first)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_DETACH, ["o"], "check out the commit under the cursor with a detached HEAD (git checkout --detach)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_QUICK, ["E"], "edit the commit under the cursor (a menu): reword, edit, drop, squash or fixup into the one before, move up or down, amend it with the staged changes, make a fixup! commit for it", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_REFLOG, ["L"], "the reflog of HEAD: every place HEAD has been; reset to one, check it out or cherry-pick it", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_JUMP, ["J"], "show or hide the jump list", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_FOCUS, ["w"], "give the jump list the keys, or take them back", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_SEARCH, ["/"], "search the outline and the log (smart-case: lower case ignores case)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_NEXT, ["n"], "next search match", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_PREVIOUS, ["N"], "previous search match", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_MERGE, ["m"], "merge: a branch into the current one, continue or abort a merge, resolve conflicts (Enter on an unmerged path)", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_PICK, ["A"], "cherry-pick the commit under the cursor (menu: now, -x, -n, a range); while one is under way: continue, skip, abort", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_REVERT, ["V"], "revert the commit under the cursor (menu: now, -n, a range); while one is under way: continue, skip, abort", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_REBASE, ["r"], "rebase the current branch (menu: onto a branch, interactively, from the commit under the cursor, --onto); while one is under way: continue, skip, abort, quit, edit the todo list", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_REFRESH, ["g", "R"], "re-read the repository", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_QUIT, ["q"], "quit", "", ""));
    table.push(Binding(SCOPE_OUTLINE, CMD_LEAVE, ["escape"], "back to the Status mode; quit from the Status mode", "", ""));
    // The document: the diff view.
    table.push(Binding(SCOPE_DIFF, CMD_DOWN, ["j", "down"], "move the diff cursor down", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_UP, ["k", "up"], "move the diff cursor up", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_SECTION_PREVIOUS, ["["], "jump to the previous hunk (first to the top of this one)", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_SECTION_NEXT, ["]"], "jump to the next hunk", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_SIBLING_PREVIOUS, ["{"], "open the previous file of this list (staged, unstaged, untracked or the commit's)", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_SIBLING_NEXT, ["}"], "open the next file of this list", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_FOLD, ["f"], "fold or unfold the hunk under the cursor", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_FOLD_ALL, ["-"], "fold every hunk", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_UNFOLD_ALL, ["+", "="], "unfold every hunk", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_STAGE, ["s"], "stage the hunk under the cursor", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_UNSTAGE, ["u"], "unstage the hunk under the cursor", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_VISUAL, ["v"], "start a visual range of lines (j/k extend it, v or Escape cancels)", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_LINES, ["space", "enter"], "stage the selected lines (unstage them in the staged view); the line under the cursor with no range, the whole hunk on its header", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_DISCARD, ["x"], "discard the selected lines from the working tree (asks first)", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_BACK, ["q", "escape", "backspace"], "cancel the visual range, else back to the outline", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_SPLIT, ["D", "|"], "side-by-side or unified diff (the choice is kept in diff.view; side by side needs 60 columns, auto picks it from 120)", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_LEFT, ["h", "left"], "side by side: put the cursor on the old side (what s, u and space act on in a changed row)", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_RIGHT, ["l", "right"], "side by side: put the cursor on the new side (the default)", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_WIDEN, ["e"], "side by side: show more unchanged lines around the hunks (3, 10, 30, 100, all)", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_WIDEN_RESET, ["E"], "side by side: back to 3 lines of context", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_WRAP, ["w"], "side by side: wrap long lines, or scroll both sides together", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_SCROLL_LEFT, ["<"], "side by side, no wrap: scroll both sides left", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_SCROLL_RIGHT, [">"], "side by side, no wrap: scroll both sides right", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_BLAME, ["B"], "blame this file", "", ""));
    table.push(Binding(SCOPE_DIFF, CMD_HISTORY, ["H"], "history of this file", "", ""));
    // In every view.
    table.push(Binding(SCOPE_GLOBAL, CMD_MODE_NEXT, ["tab"], "the next mode (Status, Commit, History, Branches, Stash; wraps)", "", ""));
    table.push(Binding(SCOPE_GLOBAL, CMD_MODE_PREV, ["back-tab"], "the previous mode", "", ""));
    table.push(Binding(SCOPE_GLOBAL, CMD_MODE_GOTO, ["1", "2", "3", "4", "5"], "jump to a mode by its number: 1 Status, 2 Commit, 3 History, 4 Branches, 5 Stash", "", ""));
    table.push(Binding(SCOPE_GLOBAL, CMD_PALETTE, [":"], "the command palette: every action of every mode, filtered as you type (also Ctrl-P)", "", ""));
    table.push(Binding(SCOPE_GLOBAL, CMD_LOG, ["@"], "the command log: one line per write operation", "", ""));
    table.push(Binding(SCOPE_GLOBAL, CMD_HELP, ["?"], "this key help", "", ""));
    table.push(Binding(SCOPE_GLOBAL, CMD_OVERVIEW, ["i"], "the overview: branch, upstream, stashes, changes, operation -- and Enter opens the picker or list for the one you are on", "", ""));
    table.push(Binding(SCOPE_GLOBAL, CMD_SYNTAX, ["C"], "syntax colours on or off (also in the blame, commit, stash and resolve views)", "", ""));
    // The overview overlay (`i`).
    table.push(Binding(SCOPE_OVERVIEW, CMD_DOWN, ["j", "down", "tab", "l", "right"], "next line", "j/k", "move"));
