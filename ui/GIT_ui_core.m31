// --- reading the repository ----------------------------------------------------

/// The character `code` types, if it types one: a printable key gives itself
/// and the space bar gives " "; Enter, Escape, the arrows and the rest give
/// nothing. For the overlays with a text field (search, picker).
pub Option<str> typed(term.Code code) {
    match (code) {
        case Char(int character): {
            if (character < 32 || character == 127) {
                return Option<str>.None;
            }
            return Option<str>.Some(str.from_chars([character]));
        }
        case Enter: {
            return Option<str>.None;
        }
        case Tab: {
            return Option<str>.None;
        }
        case BackTab: {
            return Option<str>.None;
        }
        case Backspace: {
            return Option<str>.None;
        }
        case Escape: {
            return Option<str>.None;
        }
        case Up: {
            return Option<str>.None;
        }
        case Down: {
            return Option<str>.None;
        }
        case Right: {
            return Option<str>.None;
        }
        case Left: {
            return Option<str>.None;
        }
        case Home: {
            return Option<str>.None;
        }
        case End: {
            return Option<str>.None;
        }
        case PageUp: {
            return Option<str>.None;
        }
        case PageDown: {
            return Option<str>.None;
        }
        case Insert: {
            return Option<str>.None;
        }
        case Delete: {
            return Option<str>.None;
        }
        case F(_): {
            return Option<str>.None;
        }
    }
}

/// `text` without its last character (an empty string stays empty).
pub str drop_last(str text) {
    List<int> characters = text.chars();
    if (characters.size() == 0) {
        return "";
    }
    characters.pop();
    return str.from_chars(characters);
}
