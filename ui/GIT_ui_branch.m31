// The branch layer: the branch overlay (`b`), checking a branch out, and
// making a new one with the name asked for in `$EDITOR`.
//
// The overlay's `/` opens the generic fuzzy picker (`GIT_ui_picker`) over the
// branch names; the pick comes back through `Core.picked_item` and
// `GIT_client.State.settle` calls `checkout_branch` with it.

import fs;
import core.GIT_branches;
import core.GIT_checkout;
import core.GIT_refs;
import ui.GIT_ui_commit;
import ui.GIT_ui_core;
import ui.GIT_ui_model;
import ui.GIT_ui_picker;
import ui.GIT_ui_prompt;
import io;
import os;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.widgets.TUI_menu;
import tui.widgets.TUI_outline;

pub type BranchLayer {
    pub GIT_ui_commit.CommitLayer;
}

/// `b`: open the branch overlay.
pub void BranchLayer.open_branch() {
    if (is_blocked_by_sequence("branch")) {
        return;
    }
    push_overlay(BranchOverlay(this));
}

/// The branch HEAD is on, "" when detached or unborn.
pub str BranchLayer.branch_in_use() {
    for (GIT_ui_model.BranchRow branch_row in branch_rows) {
        if (branch_row.branch.is_current) {
            return branch_row.branch.name;
        }
    }
    return "";
}

/// `b u`: `git branch --set-upstream-to=<remote>/<branch>` for the current branch.
pub void BranchLayer.set_upstream_to(str spec) {
    str branch = branch_in_use();
    int slash = spec.index_of("/").or(-1);
    if (branch == "" || slash <= 0 || slash >= spec.size() - 1) {
        message = "upstream: type remote/branch, e.g. origin/main";
        return;
    }
    str remote = spec.substr(0, slash);
    str name = spec.substr(slash + 1, spec.size());
    if (!GIT_refs.has_ref(gitdir, "refs/remotes/" + spec)) {
        message = "upstream: there is no remote-tracking branch " + spec + " (fetch first: F, f)";
        return;
    }
    match (GIT_branches.set_upstream(gitdir, branch, remote, "refs/heads/" + name)) {
        case Ok(_): {
            log_command("branch --set-upstream-to=" + spec + " " + branch);
            message = branch + " now tracks " + spec;
        }
        case Err(GIT_branches.Error error): {
            message = "upstream: " + error.to_str();
        }
    }
    reload();
}

/// `b U`: `git branch --unset-upstream`.
pub void BranchLayer.unset_upstream_now() {
    str branch = branch_in_use();
    if (branch == "") {
        message = "upstream: HEAD is not on a branch";
        return;
    }
    match (GIT_branches.unset_upstream(gitdir, branch)) {
        case Ok(_): {
            log_command("branch --unset-upstream " + branch);
            message = branch + " has no upstream now";
        }
        case Err(GIT_branches.Error error): {
            message = "upstream: " + error.to_str();
        }
    }
    reload();
}

/// `b`, then `/`: pick the branch to check out by typing part of its name.
pub void BranchLayer.open_branch_picker() {
    List<str> names = [];
    for (GIT_ui_model.BranchRow branch_row in branch_rows) {
        names.push(GIT_ui_model.picker_item(branch_row));
    }
    for (str remote_name in remote_branch_names()) {
        names.push(remote_name);
    }
    GIT_ui_picker.open(core(), GIT_ui_core.PICK_CHECKOUT, "check out a branch (origin/<name>: remote, a tracking branch is made)", names);
}

/// `b`, then `r`: the picker over the remote-tracking branches only.
pub void BranchLayer.open_remote_picker() {
    List<str> names = remote_branch_names();
    if (names.size() == 0) {
        message = "no remote-tracking branches yet (fetch first: F, f)";
        return;
    }
    GIT_ui_picker.open(core(), GIT_ui_core.PICK_REMOTE_CHECKOUT, "check out a remote branch", names);
}

/// `origin/main`, `origin/feature/x`, ...: every `refs/remotes/*/*` but a
/// remote's `HEAD`, sorted.
pub List<str> BranchLayer.remote_branch_names() {
    List<str> names = [];
    match (GIT_refs.all(gitdir)) {
        case Ok(List<GIT_refs.Ref> refs): {
            for (GIT_refs.Ref entry in refs) {
                if (entry.name.starts_with("refs/remotes/") && !entry.name.ends_with("/HEAD")) {
                    names.push(entry.name.substr(13, entry.name.size()));
                }
            }
        }
        case Err: {
        }
    }
    names.sort();
    return names;
}

/// `git switch <name>` for a remote-tracking branch `origin/<name>`: when a
/// local branch `<name>` exists, switch to it; otherwise create it at the
/// remote branch's commit with `branch.<name>.remote` and `.merge` set
/// (tracking), switch to it, and undo the creation if the switch is refused.
pub void BranchLayer.track_remote(str remote_branch) {
    int slash = remote_branch.index_of("/").or(-1);
    if (slash <= 0 || slash == remote_branch.size() - 1) {
        message = "no such branch: " + remote_branch;
        return;
    }
    str remote = remote_branch.substr(0, slash);
    str name = remote_branch.substr(slash + 1, remote_branch.size());
    str id = "";
    match (GIT_refs.resolve(gitdir, "refs/remotes/" + remote_branch)) {
        case Ok(str found): {
            id = found;
        }
        case Err: {
            message = "no such branch: " + remote_branch;
            return;
        }
    }
    str full = "refs/heads/" + name;
    if (GIT_refs.has_ref(gitdir, full)) {
        checkout_branch(name);
        return;
    }
    match (GIT_refs.update(gitdir, full, id, Option<str>.Some(""), reflog_message: "branch: Created from " + remote_branch)) {
        case Ok: {
        }
        case Err(GIT_refs.Error error): {
            message = "new branch refused: " + error.to_str();
            return;
        }
    }
    match (GIT_checkout.checkout(gitdir, worktree, id, full)) {
        case Ok(GIT_checkout.Summary summary): {
            match (GIT_branches.set_upstream(gitdir, name, remote, "refs/heads/" + name)) {
                case Ok: {
                }
                case Err(GIT_branches.Error error): {
                    message = "tracking not recorded: " + error.to_str();
                }
            }
            message = "switched to new branch " + name + " tracking " + remote_branch;
            log_command("checkout --track " + remote_branch);
            reload();
        }
        case Err(GIT_checkout.Error error): {
            match (GIT_branches.delete_ref(gitdir, full)) {
                case Ok: {
                }
                case Err: {
                }
            }
            message = "checkout refused: " + error.to_str();
        }
    }
}

/// Check out the branch under the cursor (`b`, then `c`): `GIT_checkout.checkout`
/// with every refusal it makes shown in the message line, word for word --
/// a dirty file, an untracked file in the way, a submodule. A no-op with a
/// message on anything that is not a branch row, or on the current branch.
pub void BranchLayer.checkout_current() {
    str name = "";
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            if (row.node.id.starts_with("branch:")) {
                name = row.node.id.substr(7, row.node.id.size());
            }
        }
        case None: {
        }
    }
    if (name == "") {
        message = "checkout: put the cursor on a branch first";
        return;
    }
    checkout_branch(name);
}

/// `git switch <name>`, by name -- `checkout_current`'s work, callable from a
/// test harness without an outline.
pub void BranchLayer.checkout_branch(str name) {
    for (GIT_ui_model.BranchRow branch_row in branch_rows) {
        if (branch_row.branch.name == name) {
            if (branch_row.branch.is_current) {
                message = "already on " + name;
                return;
            }
            match (GIT_checkout.checkout(gitdir, worktree, branch_row.branch.id, branch_row.branch.full)) {
                case Ok(GIT_checkout.Summary summary): {
                    message = "switched to " + name + " (" + summary.written.to_str() + " written, " + summary.removed.to_str() + " removed)";
                    log_command("checkout " + name);
                    reload();
                }
                case Err(GIT_checkout.Error error): {
                    message = "checkout refused: " + error.to_str();
                }
            }
            return;
        }
    }
    if (name.contains("/")) {
        track_remote(name);
        return;
    }
    message = "no such branch: " + name;
}

/// `b`, then `n`: ask for a name the same way `c` asks for a message -- a
/// file (`branch_name_path`) handed to `$EDITOR` once `TUI_app.Loop.run` has
/// given the terminal back (see `edit_message`'s own header for why the
/// launch cannot happen here). `launch_branch_editor` reads it back.
pub void BranchLayer.new_branch() {
    match (io.write(branch_name_path, "\n# Name the new branch on the first line. It starts at HEAD and\n# becomes the current branch. An empty name aborts.\n")) {
        case Ok: {
        }
        case Err(io.Error error): {
            message = "cannot write " + branch_name_path + ": " + error.to_str();
            return;
        }
    }
    is_editor_for_branch = true;
    is_editor_wanted = true;
    message = "launching editor...";
}

/// The second half of `new_branch`, after `$EDITOR` has run: the first
/// non-comment line is the name; `GIT_checkout.create_branch` does the rest.
pub void BranchLayer.launch_branch_editor() {
    str editor = GIT_ui_model.editor_for(gitdir);
    bool has_run = false;
    match (os.run([editor, branch_name_path])) {
        case Ok(os.ExitStatus exit_status): {
            match (exit_status) {
                case Exited(int code): {
                    if (code == 0) {
                        has_run = true;
                    } else {
                        message = "editor '" + editor + "' exited " + code.to_str() + "; no branch created";
                    }
                }
                case Signaled(int sig): {
                    message = "editor '" + editor + "' was killed by signal " + sig.to_str() + "; no branch created";
                }
            }
        }
        case Err(io.Error error): {
            message = "cannot launch '" + editor + "' (" + error.to_str() + "); no branch created";
        }
    }
    if (has_run) {
        finish_new_branch();
    }
    if (fs.is_present(branch_name_path)) {
        match (fs.remove(branch_name_path)) {
            case Ok: {
            }
            case Err: {
            }
        }
    }
}

/// Create the branch named in `branch_name_path` and switch to it -- split
/// from `launch_branch_editor` so a harness can write the file itself and
/// drive this directly, the way `t_gitclient_ops.m31`'s `commit` does for
/// `finish_commit`.
pub void BranchLayer.finish_new_branch() {
    str raw = "";
    match (io.read(branch_name_path)) {
        case Ok(str branch_text): {
            raw = branch_text;
        }
        case Err(io.Error error): {
            message = "cannot read " + branch_name_path + ": " + error.to_str();
            return;
        }
    }
    str name = GIT_ui_model.strip_comment_lines(raw).trim();
    if (name == "") {
        message = "no branch created (empty name)";
        return;
    }
    match (GIT_checkout.create_branch(gitdir, name)) {
        case Ok: {
            message = "created and switched to " + name;
            log_command("branch " + name);
            log_command("checkout " + name);
            reload();
        }
        case Err(GIT_checkout.Error error): {
            message = "new branch refused: " + error.to_str();
        }
    }
}

// --- the overlay ------------------------------------------------------------------

type BranchOverlay {
    BranchLayer host;
}

pub TUI_app.Action BranchOverlay.handle_key(term.Code code) {
    match (GIT_ui_core.lookup(GIT_ui_core.SCOPE_BRANCH, code)) {
        case Some(str cmd): {
            host.pop_overlay();
            if (cmd == GIT_ui_core.CMD_CHECKOUT) {
                host.checkout_current();
            }
            if (cmd == GIT_ui_core.CMD_PICK_BRANCH) {
                host.open_branch_picker();
            }
            if (cmd == GIT_ui_core.CMD_REMOTE_BRANCH) {
                host.open_remote_picker();
            }
            if (cmd == GIT_ui_core.CMD_BRANCH_UPSTREAM) {
                if (host.branch_in_use() == "") {
                    host.say("upstream: HEAD is not on a branch");
                } else {
                    GIT_ui_prompt.open(host.core(), this, "upstream", "set upstream of " + host.branch_in_use() + " to (remote/branch)");
                }
            }
            if (cmd == GIT_ui_core.CMD_BRANCH_UNSET_UPSTREAM) {
                host.unset_upstream_now();
            }
            if (cmd == GIT_ui_core.CMD_NEW_BRANCH) {
                host.new_branch();
                if (host.is_editor_wanted) {
                    return TUI_app.Action.Quit;
                }
            }
            return TUI_app.Action.Redraw;
        }
        case None: {
        }
    }
    return TUI_app.Action.Continue;
}

/// The prompt's answer (`GIT_ui_prompt.Receiver`).
pub void BranchOverlay.received(str purpose, str text) {
    if (purpose == "upstream") {
        host.set_upstream_to(text.trim());
    }
}

pub void BranchOverlay.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_menu.WhichKey which_key = TUI_menu.WhichKey("branch", [TUI_menu.Item("c", "check out the branch under the cursor"), TUI_menu.Item("/", "check out a branch picked by typing part of its name"), TUI_menu.Item("r", "check out a remote branch: creates a local branch tracking it"), TUI_menu.Item("n", "new branch from HEAD: name it in $EDITOR, then switch to it"), TUI_menu.Item("u", "set the current branch's upstream to a remote branch you type"), TUI_menu.Item("U", "unset the current branch's upstream"), TUI_menu.Item("a", "abort")]);
    which_key.render(buffer, area);
}

pub List<GIT_ui_core.Hint> BranchOverlay.hints() {
    return GIT_ui_core.hints_for(GIT_ui_core.SCOPE_BRANCH);
}
