// The commit layer: what the Commit mode does (`c` starts it), the message file and the
// `$EDITOR` handoff that starts, `git commit --amend`, and writing the commit.
//
// See `GIT_client.m31`'s header, "launching `$EDITOR`, and the terminal
// handoff that takes", for why `edit_message` cannot launch the editor itself.

import fs;
import core.GIT_config;
import core.GIT_index;
import diff.GIT_merge;
import core.GIT_object;
import core.GIT_refs;
import ui.GIT_ui_core;
import ui.GIT_ui_lines;
import ui.GIT_ui_model;
import io;
import term;
import tui.app.TUI_app;
import tui.core.TUI_buffer;
import tui.core.TUI_geometry;
import tui.widgets.TUI_menu;

pub type CommitLayer {
    pub GIT_ui_lines.LinesLayer;
}

/// `c`: start a commit -- the caller then switches to the Commit mode, which
/// is where `e`, `f`, `A` and `a` live. False, with the reason in `message`,
/// while a cherry-pick, revert or rebase is under way.
pub bool CommitLayer.begin_commit() {
    if (is_blocked_by_sequence("commit")) {
        return false;
    }
    is_amending = false;
    return true;
}

/// Write the commit-message template at `commit_message_path`, unless something
/// -- a previous `e`, or a person's own `git commit` in another terminal --
/// already left one there, and ask `mgit.m31`'s own driver to actually
/// launch `$EDITOR` on it once the terminal is safe to hand over.
///
/// This cannot call `os.run` itself: the terminal is still in raw mode with
/// the alternate screen on, owned by a `term.Session` this state has no
/// access to (`TUI_app.Loop.run`'s own scope). Setting `is_editor_wanted` and
/// letting the which-key's `e` return `Quit` is what unwinds that scope --
/// see this module's own header, "launching `$EDITOR`, and the terminal
/// handoff that takes" -- so `launch_editor` below is where the actual
/// launch happens, called back once the terminal is cooked again.
pub void CommitLayer.edit_message() {
    bool is_merge = GIT_merge.is_in_progress(gitdir);
    bool is_leftover = !is_merge && GIT_ui_model.is_stale_message(gitdir, commit_message_path, is_amending);
    if (!fs.is_present(commit_message_path) || is_leftover || (is_merge && !GIT_merge.is_message_file_current(gitdir, commit_message_path))) {
        // A merge under way starts from its own message (`MERGE_MSG`).
        str prefill = "";
        if (is_merge) {
            prefill = GIT_merge.merge_message_text(gitdir);
            if (prefill != "" && !prefill.ends_with("\n")) {
                prefill = prefill + "\n";
            }
        }
        match (io.write(commit_message_path, prefill + GIT_ui_model.commit_template())) {
            case Ok: {
            }
            case Err(io.Error error): {
                message = "cannot write " + commit_message_path + ": " + error.to_str();
                return;
            }
        }
    }
    is_editor_wanted = true;
    message = "launching editor...";
}

/// The `Signed-off-by:` line for the committer: `user.name` and `user.email`
/// (or the `GIT_COMMITTER_*` variables, as git reads them).
pub str CommitLayer.signoff_text() {
    GIT_object.Ident who = GIT_ui_model.committer_ident(gitdir);
    return GIT_ui_model.signoff_line(who.name.utf8().or(""), who.email.utf8().or(""));
}

/// `s` in the Commit mode: sign-off on or off for the commits made from here.
pub void CommitLayer.toggle_signoff() {
    is_signoff = !is_signoff;
    if (is_signoff) {
        message = "sign-off on: " + signoff_text() + " will be added";
    } else {
        message = "sign-off off";
    }
}

/// `a` in the Commit mode: throw the draft away -- after asking, naming what
/// goes (the draft's first line, and the amend), when there is anything to lose.
pub void CommitLayer.confirm_abort() {
    str lost = "";
    match (io.read(commit_message_path)) {
        case Ok(str raw): {
            str stripped = GIT_ui_model.strip_comment_lines(raw);
            if (stripped != "" && !GIT_ui_model.is_stale_message(gitdir, commit_message_path, is_amending)) {
                lost = "the draft message \"" + stripped.split("\n")[0] + "\"";
            }
        }
        case Err(_): {
        }
    }
    if (is_amending) {
        if (lost != "") {
            lost = lost + " and the amend";
        } else {
            lost = "the amend of HEAD";
        }
    }
    if (lost == "") {
        abort_commit();
        return;
    }
    push_overlay(DraftConfirm(this, lost));
}

pub void CommitLayer.abort_commit() {
    if (fs.is_present(commit_message_path)) {
        match (fs.remove(commit_message_path)) {
            case Ok: {
            }
            case Err: {
            }
        }
    }
    is_overlay_done = true;
    is_amending = false;
    message = "commit aborted";
}

/// `c` then `A`: turn the open commit overlay into `git commit --amend`.
/// HEAD's own message is written to `commit_message_path` (with the template's
/// comment lines after it, so `e` opens something a person recognises and
/// `f` straight away is `--amend --no-edit`), and `is_amending` tells
/// `finish_commit` to replace HEAD rather than add to it. Refused, with the
/// overlay left open on its ordinary meaning, when there is no HEAD to
/// amend: an unborn branch, or a HEAD whose commit cannot be read.
pub void CommitLayer.start_amend() {
    str head_id = "";
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str id): {
                    head_id = id;
                }
                case Unborn(str name): {
                    message = "nothing to amend: no commits yet on " + GIT_ui_model.branch_name(name);
                    return;
                }
                case Detached(str id): {
                    head_id = id;
                }
            }
        }
        case Err(GIT_refs.Error error): {
            message = "nothing to amend: refs.head: " + error.to_str();
            return;
        }
    }
    bytes head_message = [];
    match (GIT_object.read(gitdir, head_id)) {
        case Ok(GIT_object.Object object): {
            match (object.body) {
                case Commit(GIT_object.Commit commit): {
                    head_message = commit.message;
                }
                case Blob: {
                    message = "nothing to amend: HEAD is not a commit";
                    return;
                }
                case Tree(List<GIT_object.Entry> ignored): {
                    message = "nothing to amend: HEAD is not a commit";
                    return;
                }
                case Tag: {
                    message = "nothing to amend: HEAD is not a commit";
                    return;
                }
            }
        }
        case Err(GIT_object.Error error): {
            message = "nothing to amend: cannot read HEAD's commit: " + error.to_str();
            return;
        }
    }
    str prefill = head_message.utf8().or("");
    if (!prefill.ends_with("\n")) {
        prefill = prefill + "\n";
    }
    match (io.write(commit_message_path, prefill + GIT_ui_model.commit_template())) {
        case Ok: {
        }
        case Err(io.Error error): {
            message = "cannot write " + commit_message_path + ": " + error.to_str();
            return;
        }
    }
    is_amending = true;
    message = "amending " + head_id.substr(0, 7) + ": e to edit its message, f to finish, a to abort";
}

/// Read `commit_message_path` back, strip it the way git's default cleanup does,
/// and either refuse (an empty result, git's own "Aborting commit due to
/// empty commit message") or actually commit: `build_tree` over the current
/// index, `GIT_object.write_commit` with HEAD as the sole parent (none for an
/// unborn branch), and `GIT_refs.update` to move the branch -- or `HEAD` itself,
/// detached -- forward by compare-and-swap against the value just read, so a
/// second writer racing this one is refused rather than silently overwritten
/// (`GIT_refs.m31`'s own guarantee).
pub void CommitLayer.finish_commit() {
    bool is_merge = GIT_merge.is_in_progress(gitdir);
    if (is_merge && is_amending) {
        message = "cannot amend while a merge is under way";
        return;
    }
    if (GIT_config.is_commit_gpgsign_enabled(gitdir)) {
        message = GIT_config.GPGSIGN_REFUSAL + "; the message is kept at " + commit_message_path;
        return;
    }
    str raw = "";
    if (is_merge && !GIT_merge.is_message_file_current(gitdir, commit_message_path)) {
        raw = GIT_merge.merge_message_text(gitdir);
    } else {
        match (io.read(commit_message_path)) {
            case Ok(str edited_text): {
                // git's leftover from an earlier commit is not a message
                if (!GIT_ui_model.is_stale_message(gitdir, commit_message_path, is_amending)) {
                    raw = edited_text;
                }
            }
            case Err(io.Error error): {
                message = "cannot read " + commit_message_path + ": " + error.to_str();
                return;
            }
        }
    }
    str commit_message = GIT_ui_model.strip_comment_lines(raw);
    if (commit_message == "") {
        message = "aborting commit due to empty commit message";
        is_overlay_done = true;
        is_amending = false;
        return;
    }
    if (is_signoff) {
        commit_message = GIT_ui_model.with_signoff(commit_message, signoff_text());
    }
    GIT_index.Index index = GIT_ui_model.read_index(gitdir);
    if (is_merge) {
        for (GIT_index.Entry entry in index.entries) {
            if (entry.stage != 0) {
                message = "cannot commit: unmerged paths remain (Enter on one under Unmerged paths)";
                return;
            }
        }
    }
    str tree_id = "";
    match (GIT_ui_model.build_tree(gitdir, index.entries)) {
        case Ok(str tree): {
            tree_id = tree;
        }
        case Err(GIT_object.Error error): {
            message = "write_tree: " + error.to_str();
            return;
        }
    }
    List<str> parents = [];
    str ref_name = "HEAD";
    str expect_old = "";
    bool has_old = false;
    match (GIT_refs.head(gitdir)) {
        case Ok(GIT_refs.Head head): {
            match (head) {
                case Born(str name, str id): {
                    parents.push(id);
                    ref_name = name;
                    expect_old = id;
                    has_old = true;
                }
                case Unborn(str name): {
                    ref_name = name;
                    expect_old = "";
                    has_old = true;
                }
                case Detached(str id): {
                    parents.push(id);
                    ref_name = "HEAD";
                    expect_old = id;
                    has_old = true;
                }
            }
        }
        case Err(GIT_refs.Error error): {
            message = "refs.head: " + error.to_str();
            return;
        }
    }
    GIT_object.Ident author = GIT_ui_model.author_ident(gitdir);
    if (is_merge) {
        for (str merge_parent in GIT_merge.merge_heads(gitdir)) {
            parents.push(merge_parent);
        }
    }
    if (is_amending) {
        // `--amend`: the new commit takes HEAD's place, so it gets HEAD's own
        // parents and author (date and zone included -- real git keeps the
        // original authorship and only the committer is "now"); HEAD itself
        // is what the compare-and-swap below expects to replace.
        if (parents.size() == 0) {
            message = "nothing to amend: no commits yet";
            return;
        }
        match (GIT_object.read(gitdir, parents[0])) {
            case Ok(GIT_object.Object object): {
                match (object.body) {
                    case Commit(GIT_object.Commit commit): {
                        parents = commit.parents;
                        author = commit.author;
                    }
                    case Blob: {
                        message = "amend: HEAD is not a commit";
                        return;
                    }
                    case Tree(List<GIT_object.Entry> ignored): {
                        message = "amend: HEAD is not a commit";
                        return;
                    }
                    case Tag: {
                        message = "amend: HEAD is not a commit";
                        return;
                    }
                }
            }
            case Err(GIT_object.Error error): {
                message = "amend: cannot read HEAD's commit: " + error.to_str();
                return;
            }
        }
    }
    GIT_object.Commit commit = GIT_object.Commit(tree_id, parents, author, GIT_ui_model.committer_ident(gitdir), [], (commit_message + "\n").to_bytes());
    str commit_id = "";
    match (GIT_object.write_commit(gitdir, commit)) {
        case Ok(str id): {
            commit_id = id;
        }
        case Err(GIT_object.Error error): {
            message = "write_commit: " + error.to_str();
            return;
        }
    }
    Option<str> want = Option<str>.None;
    if (has_old) {
        want = Option<str>.Some(expect_old);
    }
    match (GIT_refs.update(gitdir, ref_name, commit_id, want)) {
        case Ok: {
            str old_short = GIT_ui_core.short_id(expect_old);
            if (is_amending) {
                log_command("amend " + commit_id.substr(0, 7));
            } else {
                log_command("commit " + commit_id.substr(0, 7));
            }
            log_command("update-ref " + ref_name + " " + old_short + ".." + commit_id.substr(0, 7));
            if (is_merge) {
                GIT_merge.clear_state(gitdir);
            }
        }
        case Err(GIT_refs.Error error): {
            message = "refs.update: " + error.to_str();
            return;
        }
    }
    if (fs.is_present(commit_message_path)) {
        match (fs.remove(commit_message_path)) {
            case Ok: {
            }
            case Err: {
            }
        }
    }
    if (is_amending) {
        message = "amended: HEAD is now " + commit_id.substr(0, 7);
    } else {
        message = "committed " + commit_id.substr(0, 7);
    }
    is_overlay_done = true;
    is_amending = false;
    reload();
}

// --- discarding the draft asks first ----------------------------------------------

type DraftConfirm {
    CommitLayer host;
    str what;
}

/// `y` discards; every other key keeps the draft (as for a discarded file: a
/// prompt that acts on one exact key cannot be fallen into by a stray one).
pub TUI_app.Action DraftConfirm.handle_key(term.Code code) {
    host.pop_overlay();
    match (GIT_ui_core.lookup(GIT_ui_core.SCOPE_CONFIRM, code)) {
        case Some(str cmd): {
            if (cmd == GIT_ui_core.CMD_YES) {
                host.abort_commit();
                return TUI_app.Action.Redraw;
            }
        }
        case None: {
        }
    }
    host.say("kept the draft");
    return TUI_app.Action.Redraw;
}

pub void DraftConfirm.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_menu.WhichKey which_key = TUI_menu.WhichKey("discard " + what + "?", [TUI_menu.Item("y", "yes, discard"), TUI_menu.Item("any other key", "no, keep it")]);
    which_key.render(buffer, area);
}

pub List<GIT_ui_core.Hint> DraftConfirm.hints() {
    return GIT_ui_core.hints_for(GIT_ui_core.SCOPE_CONFIRM);
}
