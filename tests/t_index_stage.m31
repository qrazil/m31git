// Stages one new file -- writes its blob, builds an entry with
// `GIT_index.from_stat`, appends it to the index, and writes the index back --
// so `test_write.sh` can confirm real `git status`/`ls-files --stage` sees
// exactly what was staged.
//
//   ./t_index_stage <gitdir> <worktree> <relative-path>

import core.GIT_index;
import core.GIT_object;
import fs;
import io;
import os;

List<str> argv = os.arguments();
if (argv.size() < 4) {
    io.eprint("usage: t_index_stage <gitdir> <worktree> <relative-path>");
    os.exit(2);
}
str git_directory = argv[1];
str worktree = argv[2];
str relative_path = argv[3];
str full = fs.join(worktree, relative_path);
bytes content = [];
match (io.read_bytes(full)) {
    case Ok(bytes contents): {
        content = contents;
    }
    case Err(io.Error error): {
        io.eprint("read: " + error.to_str());
        os.exit(1);
    }
}
str blob_id = "";
match (GIT_object.write_blob(git_directory, content)) {
    case Ok(str id): {
        blob_id = id;
    }
    case Err(GIT_object.Error error): {
        io.eprint("write_blob: " + error.to_str());
        os.exit(1);
    }
}
fs.Stat file_stat = fs.Stat(0, 0, 0);
match (fs.stat(full)) {
    case Ok(fs.Stat stat): {
        file_stat = stat;
    }
    case Err(io.Error error): {
        io.eprint("stat: " + error.to_str());
        os.exit(1);
    }
}
GIT_index.Entry entry = GIT_index.from_stat(relative_path.to_bytes(), file_stat, fs.is_link(full), blob_id);
GIT_index.Index original = GIT_index.Index([]);
match (GIT_index.read(git_directory)) {
    case Ok(GIT_index.Index index): {
        original = index;
    }
    case Err(GIT_index.Error error): {
        match (error) {
            case NotFound: {
            }
            case Io: {
                io.eprint("read: " + error.to_str());
                os.exit(1);
            }
            case BadSignature: {
                io.eprint("read: " + error.to_str());
                os.exit(1);
            }
            case BadVersion: {
                io.eprint("read: " + error.to_str());
                os.exit(1);
            }
            case Truncated: {
                io.eprint("read: " + error.to_str());
                os.exit(1);
            }
            case BadExtension: {
                io.eprint("read: " + error.to_str());
                os.exit(1);
            }
            case Checksum: {
                io.eprint("read: " + error.to_str());
                os.exit(1);
            }
            case RequiredExtension: {
                io.eprint("read: " + error.to_str());
                os.exit(1);
            }
            case Locked: {
                io.eprint("read: " + error.to_str());
                os.exit(1);
            }
            case Changed: {
                io.eprint("read: " + error.to_str());
                os.exit(1);
            }
        }
    }
}
original.entries.push(entry);
match (GIT_index.write(git_directory, original)) {
    case Ok: {
        print("staged " + blob_id);
    }
    case Err(GIT_index.Error error): {
        io.eprint("write: " + error.to_str());
        os.exit(1);
    }
}
